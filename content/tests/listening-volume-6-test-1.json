      {
        "number": 3,
        "title": "Part 3",
        "instructionsHtml": "<p>Listen and answer questions 21–30.</p>",
        "groups": [
          {
            "id": "part-3-group-1",
            "type": "mcq",
            "rubricHtml": "<p>Questions 21–26</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 21,
                "textHtml": "&nbsp;Why is Fiona keen to organise a debate?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "She has attended debates in other departments."
                  },
                  {
                    "letter": "B",
                    "textHtml": "She organised debates while at secondary school."
                  },
                  {
                    "letter": "C",
                    "textHtml": "She has talked about debating with a friend."
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "&nbsp;Fiona says that an advantage of debating is that it can",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "help students to form opinions."
                  },
                  {
                    "letter": "B",
                    "textHtml": "improve students' listening skills."
                  },
                  {
                    "letter": "C",
                    "textHtml": "develop students' self-confidence."
                  }
                ]
              },
              {
                "number": 23,
                "textHtml": "&nbsp;How will the debate topic be selected?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "Daniel and Fiona will ask the lecturer to choose one from a list."
                  },
                  {
                    "letter": "B",
                    "textHtml": "The other students will select one of Daniel and Fiona's suggestions."
                  },
                  {
                    "letter": "C",
                    "textHtml": "Daniel and Fiona will collect suggestions from the other students."
                  }
                ]
              },
              {
                "number": 24,
                "textHtml": "&nbsp;Daniel and Fiona think one key to a successful debate is for students to",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "have a topic that really involves them."
                  },
                  {
                    "letter": "B",
                    "textHtml": "plan their speech carefully."
                  },
                  {
                    "letter": "C",
                    "textHtml": "be given positions to defend."
                  }
                ]
              },
              {
                "number": 25,
                "textHtml": "&nbsp;Daniel thinks it would be good for the students to be in two teams because it would",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "give everyone a chance to speak."
                  },
                  {
                    "letter": "B",
                    "textHtml": "help students with less confidence."
                  },
                  {
                    "letter": "C",
                    "textHtml": "share out the preparation required."
                  }
                ]
              },
              {
                "number": 26,
                "textHtml": "&nbsp;What does the lecturer agree to do after the debate?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "make comments on students' written work."
                  },
                  {
                    "letter": "B",
                    "textHtml": "help Daniel and Fiona to write a report."
                  },
                  {
                    "letter": "C",
                    "textHtml": "set the students an essay on a different topic."
                  }
                ]
              }
            ]
