            "type": "mcq",
            "rubricHtml": "<p>Questions 11–15</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 11,
                "textHtml": "&nbsp;What does Mark say first attracts people to working for Johnson Jones?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the pay"
                  },
                  {
                    "letter": "B",
                    "textHtml": "the staff discount"
                  },
                  {
                    "letter": "C",
                    "textHtml": "the working hours"
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "&nbsp;Mark says the company is one of the country’s most successful retailers because it",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "is focused on long term planning."
                  },
                  {
                    "letter": "B",
                    "textHtml": "provides excellent customer service."
                  },
                  {
                    "letter": "C",
                    "textHtml": "offers value for money."
                  }
                ]
              },
              {
                "number": 13,
                "textHtml": "&nbsp;Mark says that because Johnson Jones is a partnership, the staff",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "are better trained."
                  },
                  {
                    "letter": "B",
                    "textHtml": "have better job security."
                  },
                  {
                    "letter": "C",
                    "textHtml": "are given more responsibility."
                  }
                ]
              },
              {
                "number": 14,
                "textHtml": "&nbsp;What is the typical annual bonus that partners receive?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "8%"
                  },
                  {
                    "letter": "B",
                    "textHtml": "15%"
                  },
                  {
                    "letter": "C",
                    "textHtml": "20%"
                  }
                ]
              },
              {
                "number": 15,
                "textHtml": "&nbsp;To qualify for the leisure and holiday facilities, partners must have worked for the company for",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "one year."
                  },
                  {
                    "letter": "B",
                    "textHtml": "six months."
                  },
                  {
                    "letter": "C",
                    "textHtml": "three months."
                  }
                ]
              }
            ]
