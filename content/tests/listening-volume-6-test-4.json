              {
                "number": 17,
                "textHtml": "&nbsp;When will the programme for the Youth Arts Festival be finalised?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the middle of March"
                  },
                  {
                    "letter": "B",
                    "textHtml": "the end of April"
                  },
                  {
                    "letter": "C",
                    "textHtml": "the beginning of August"
                  }
                ]
              },
              {
                "number": 18,
                "textHtml": "&nbsp;An application to put on a performance at the festival must include",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "a DVD of the performance."
                  },
                  {
                    "letter": "B",
                    "textHtml": "a short summary of the performance."
                  },
                  {
                    "letter": "C",
                    "textHtml": "details of costumes and music used in the performance."
                  }
                ]
              },
              {
                "number": 19,
                "textHtml": "&nbsp;The winner of the play-writing competition will be offered the chance to",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "take part in their own play"
                  },
                  {
                    "letter": "B",
                    "textHtml": "have their play shown on TV"
                  },
                  {
                    "letter": "C",
                    "textHtml": "direct their play at the festival."
                  }
                ]
              },
              {
                "number": 20,
                "textHtml": "&nbsp;What is unusual about the production of 'Calcamon'?",
                "options": [
