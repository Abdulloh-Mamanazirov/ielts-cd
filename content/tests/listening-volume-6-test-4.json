            "selectCount": 1,
            "questions": [
              {
                "number": 21,
                "textHtml": "&nbsp;The tutor points out to Lara that in different markets, a brand of chocolate",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "has different proportions of the ingredients."
                  },
                  {
                    "letter": "B",
                    "textHtml": "uses different methods of advertising."
                  },
                  {
                    "letter": "C",
                    "textHtml": "is sold at different prices."
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "&nbsp;Which aim of global marketing has Lara explained very clearly?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "making profit"
                  },
                  {
                    "letter": "B",
                    "textHtml": "maximising sales"
                  },
                  {
                    "letter": "C",
                    "textHtml": "expanding production"
                  }
                ]
              },
              {
                "number": 23,
                "textHtml": "&nbsp;The tutor gives the example of the supermarket chain to show how companies",
