            "questions": [
              {
                "number": 21,
                "textHtml": "&nbsp;Izzy believes the 'safety bicycle' is significant because it was",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "specifically made for children to use."
                  },
                  {
                    "letter": "B",
                    "textHtml": "the first bicycle to be similar to modern bicycles."
                  },
                  {
                    "letter": "C",
                    "textHtml": "designed to travel at higher speeds than previous models."
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "&nbsp;What effect of bicycles on the 19th-century working classes does Max want to highlight?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "how people spent their free time"
                  },
                  {
                    "letter": "B",
                    "textHtml": "where people were employed"
