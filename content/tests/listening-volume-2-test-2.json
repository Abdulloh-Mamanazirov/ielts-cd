                  {
                    "letter": "A",
                    "textHtml": "critical."
                  },
                  {
                    "letter": "B",
                    "textHtml": "doubtful."
                  },
                  {
                    "letter": "C",
                    "textHtml": "boastful."
                  }
                ]
              },
              {
                "number": 27,
                "textHtml": "&nbsp;Rangi is disappointed because he",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "will have to work in a bar again."
                  },
                  {
                    "letter": "B",
                    "textHtml": "cannot afford to study abroad."
                  },
                  {
                    "letter": "C",
                    "textHtml": "will not be going to Europe."
                  }
                ]
              },
              {
                "number": 28,
                "textHtml": "&nbsp;The Professor offers Rangi",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "a part-time job in his lab."
                  },
                  {
                    "letter": "B",
                    "textHtml": "supervision of his master's degree."
                  },
                  {
                    "letter": "C",
                    "textHtml": "help with his laser experiments."
                  }
                ]
              },
              {
                "number": 29,
                "textHtml": "&nbsp;In the Professor's opinion, Rangi is",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "quite likely to win a scholarship."
                  },
                  {
                    "letter": "B",
                    "textHtml": "not so likely to win a scholarship."
                  },
                  {
                    "letter": "C",
                    "textHtml": "highly likely to win a scholarship."
                  }
                ]
              },
              {
                "number": 30,
                "textHtml": "&nbsp;What did Rangi feel by the end of the conversation?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "thrilled but nervous"
                  },
                  {
                    "letter": "B",
                    "textHtml": "relieved and grateful"
                  },
                  {
                    "letter": "C",
                    "textHtml": "a little apprehensive"
                  }
                ]
              }
            ]
          }
