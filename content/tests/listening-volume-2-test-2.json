          {
            "id": "part-2-group-1",
            "type": "mcq",
            "rubricHtml": "<p>Questions 11–16</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 11,
                "textHtml": "&nbsp;When was Eyesaver founded?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "15 years ago"
                  },
                  {
                    "letter": "B",
                    "textHtml": "30 years ago"
                  },
                  {
                    "letter": "C",
                    "textHtml": "60 years ago"
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "&nbsp;What was the original aim of the program?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "to offer common equipment"
                  },
                  {
                    "letter": "B",
                    "textHtml": "to offer medication to children with eye diseases"
                  },
                  {
                    "letter": "C",
                    "textHtml": "to offer operational help to people who had eye problems"
                  }
                ]
              },
              {
                "number": 13,
                "textHtml": "&nbsp;The main funding comes from",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "monthly donation."
                  },
                  {
                    "letter": "B",
                    "textHtml": "donation from rich people."
                  },
                  {
                    "letter": "C",
                    "textHtml": "money collected on the street."
                  }
                ]
              },
              {
                "number": 14,
                "textHtml": "&nbsp;What does the speaker expect listeners to provide?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "glasses for the patients"
                  },
                  {
                    "letter": "B",
                    "textHtml": "money donation"
                  },
                  {
                    "letter": "C",
                    "textHtml": "voluntary work"
                  }
                ]
              },
              {
                "number": 15,
                "textHtml": "&nbsp;What is the main purpose of this program?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "to show people their donation can make a difference"
                  },
                  {
                    "letter": "B",
                    "textHtml": "to show people how easily eye problems can be cured"
                  },
                  {
                    "letter": "C",
                    "textHtml": "to educate people about common eye diseases"
                  }
                ]
              },
              {
                "number": 16,
                "textHtml": "&nbsp;Eyesaver advertises for the program through",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "computers."
                  },
                  {
                    "letter": "B",
                    "textHtml": "recordings."
                  },
                  {
                    "letter": "C",
                    "textHtml": "training."
                  }
                ]
              }
            ]
          },
