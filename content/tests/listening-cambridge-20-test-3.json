              {
                "letter": "B",
                "textHtml": "It is historically significant for a country."
              },
              {
                "letter": "C",
                "textHtml": "It was effective at attracting audiences."
              },
              {
                "letter": "D",
                "textHtml": "It is included in a recent project."
              },
              {
                "letter": "E",
                "textHtml": "It contains insights into the show."
              },
              {
                "letter": "F",
                "textHtml": "It resembles an artwork."
              }
            ],
