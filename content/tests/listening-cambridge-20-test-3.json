          {
            "id": "part-2-group-1",
            "type": "mcq",
            "selectCount": 1,
            "rubricHtml": "<h3>Questions 11–16</h3><p>Choose the correct letter, <strong>A</strong>, <strong>B</strong> or <strong>C</strong>.</p>",
            "questions": [
              {
                "number": 11,
                "textHtml": "Who was responsible for starting the community project?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the castle owners"
                  },
                  {
                    "letter": "B",
                    "textHtml": "a national charity"
                  },
                  {
                    "letter": "C",
                    "textHtml": "the local council"
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "How was the gold coin found?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "Heavy rain had removed some of the soil."
                  },
                  {
                    "letter": "B",
                    "textHtml": "The ground was dug up by wild rabbits."
                  },
                  {
                    "letter": "C",
                    "textHtml": "A person with a metal detector searched the area."
                  }
                ]
              },
              {
                "number": 13,
                "textHtml": "What led the archaeologists to believe there was an ancient village on this site?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the lucky discovery of old records"
                  },
                  {
                    "letter": "B",
                    "textHtml": "the bases of several structures visible in the grass"
                  },
                  {
                    "letter": "C",
                    "textHtml": "the unusual stones found near the castle"
                  }
                ]
              },
              {
                "number": 14,
                "textHtml": "What are the team still hoping to find?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "everyday pottery"
                  },
                  {
                    "letter": "B",
                    "textHtml": "animal bones"
                  },
                  {
                    "letter": "C",
                    "textHtml": "pieces of jewellery"
                  }
                ]
              },
              {
                "number": 15,
                "textHtml": "What was found on the other side of the river to the castle?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the remains of a large palace"
                  },
                  {
                    "letter": "B",
                    "textHtml": "the outline of fields"
                  },
                  {
                    "letter": "C",
                    "textHtml": "a number of small huts"
                  }
                ]
              },
              {
                "number": 16,
                "textHtml": "What do the team plan to do after work ends this summer?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "prepare a display for a museum"
                  },
                  {
                    "letter": "B",
                    "textHtml": "take part in a television programme"
                  },
                  {
                    "letter": "C",
                    "textHtml": "start to organise school visits"
                  }
                ]
              }
            ]
