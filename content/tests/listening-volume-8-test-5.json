                "number": 21,
                "textHtml": "&nbsp;Katy thinks it might be inappropriate for academic essays to",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "give both sides of an argument."
                  },
                  {
                    "letter": "B",
                    "textHtml": "express personal opinions."
                  },
