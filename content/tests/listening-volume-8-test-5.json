                    "letter": "C",
                    "textHtml": "present a range of views."
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "&nbsp;The tutor says that in one type of conclusion students should",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "withhold their own views."
                  },
                  {
                    "letter": "B",
                    "textHtml": "avoid too much repetition."
                  },
                  {
                    "letter": "C",
                    "textHtml": "refer to the title."
                  }
                ]
              },
