            "questions": [
              {
                "number": 21,
                "textHtml": "&nbsp;What do the students agree about defining forensic linguistics?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "The dictionary definition was not very useful."
                  },
                  {
                    "letter": "B",
                    "textHtml": "They could provide an example of the kind of work involved."
                  },
                  {
                    "letter": "C",
                    "textHtml": "They should read about the subject to see how it is described."
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "&nbsp;Jen thinks it will be difficult to analyse the voice recording because",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "it is not of good quality."
                  },
                  {
                    "letter": "B",
                    "textHtml": "the accent is difficult to understand."
                  },
                  {
                    "letter": "C",
                    "textHtml": "she doesn't know if the speaker is male or female."
                  }
                ]
              },
              {
                "number": 23,
                "textHtml": "&nbsp;Why does Jen think that the 'suspect' might vary their voice patterns?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "because they're being recorded"
                  },
                  {
                    "letter": "B",
                    "textHtml": "because they've been told to"
                  },
                  {
                    "letter": "C",
                    "textHtml": "because they feel uncomfortable about their accent"
                  }
                ]
              },
              {
                "number": 24,
                "textHtml": "&nbsp;What does Rob think about Jen's approach to study?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "She worries too much about her ability."
                  },
                  {
                    "letter": "B",
                    "textHtml": "She often ignores the most important issues."
                  },
                  {
                    "letter": "C",
                    "textHtml": "She has trouble getting started."
                  }
                ]
              }
            ]
