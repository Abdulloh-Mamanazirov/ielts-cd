        ]
      },
      {
        "number": 2,
        "title": "Part 2",
        "instructionsHtml": "<p>Listen and answer questions 11–20.</p>",
        "groups": [
          {
            "id": "part-2-group-1",
            "type": "completion",
            "rubricHtml": "<p>Questions 11–18</p>",
            "selectCount": 1,
            "bodyHtml": "<p>Complete the notes below. Write <strong>NO MORE THAN TWO WORDS AND/OR A NUMBER</strong> for each answer.</p><div><div><strong>Spring Festival</strong></div><table class=\"q-table\"><tbody><tr><th>Event</th><th>Location</th><th>Date &amp; Time</th><th>Other Information</th></tr><tr><td>Firework display</td><td>Near the {{11}}</td><td>4 September, 9 p.m.</td><td>Pack a {{12}} and blanket</td></tr><tr><td>Display of {{13}}</td><td>Central Park</td><td>daily</td><td>Buses from town centre every {{14}} minutes</td></tr><tr><td>The {{15}} Show</td><td>Exhibition Centre</td><td>10–15 September, 9 a.m.–10 p.m.</td><td></td></tr><tr><td>'Grow Your Imagination'</td><td>in the {{16}}</td><td>11–19 September</td><td></td></tr><tr><td>'Swing in Spring'</td><td>in the {{17}}</td><td>17 &amp; 18 September</td><td>Saturday matinee at {{18}}</td></tr></tbody></table></div>",
            "maxWords": 2
          },
          {
            "id": "part-2-group-2",
            "type": "mcq",
            "rubricHtml": "<p>Questions 19 and 20</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 19,
                "textHtml": "&nbsp;In the Spring Festival competition, you can win",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "a family pass to 'Balloons Down Under'"
                  },
                  {
                    "letter": "B",
                    "textHtml": "a cheque for $200"
                  },
                  {
                    "letter": "C",
                    "textHtml": "a flight in a hot air balloon"
                  }
                ]
              },
              {
                "number": 20,
                "textHtml": "&nbsp;You can get an entry form for the competition from",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the radio station"
                  },
                  {
                    "letter": "B",
                    "textHtml": "the newspaper"
                  },
                  {
                    "letter": "C",
                    "textHtml": "the Festival's website"
                  }
                ]
              }
            ]
          }
        ]
