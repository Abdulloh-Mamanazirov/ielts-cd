        "instructionsHtml": "Section 1<p>Listen and answer questions 1–10.</p>",
        "groups": [
          {
            "id": "part-1-group-1",
            "type": "completion",
            "rubricHtml": "<h3>Questions 1–10</h3><p>Complete the form below.</p><p>Write <strong>ONE WORD AND/OR A NUMBER</strong> for each answer.</p>",
            "selectCount": 1,
            "maxWords": 2,
            "bodyHtml": "<table class=\"q-table\"><caption class=\"summary-title\">Crime Report Form</caption>\n<tbody>\n<tr><td><strong>Type of crime:</strong></td><td>theft</td></tr>\n<tr><td colspan=\"2\"><strong>Personal information</strong></td></tr>\n<tr><td>Name</td><td><em>Example</em>&nbsp;&nbsp;Louise <u>Taylor</u></td></tr>\n<tr><td>Nationality</td><td>{{1}}</td></tr>\n<tr><td>Date of birth</td><td>14 December 1977</td></tr>\n<tr><td>Occupation</td><td>interior designer</td></tr>\n<tr><td>Reason for visit</td><td>business (to buy antique {{2}})</td></tr>\n<tr><td>Length of stay</td><td>two months</td></tr>\n<tr><td>Current address</td><td>{{3}} Apartments (No 15)</td></tr>\n<tr><td colspan=\"2\"><strong>Details of theft</strong></td></tr>\n<tr><td>Items stolen</td><td>– a wallet containing approximately £{{4}}<br>– a {{5}}</td></tr>\n<tr><td>Date of theft</td><td>{{6}}</td></tr>\n<tr><td colspan=\"2\"><strong>Possible time and place of theft</strong></td></tr>\n<tr><td>Location</td><td>outside the {{7}} at about 4 pm</td></tr>\n<tr><td>Details of suspect</td><td>– some boys asked for the {{8}} then ran off<br>– one had a T-shirt with a picture of a tiger<br>– he was about 12, slim build with {{9}} hair</td></tr>\n<tr><td colspan=\"2\"><strong>Crime reference number allocated</strong><br>{{10}}</td></tr>\n</tbody></table>"
          }
        ]
      },
      {
        "number": 2,
        "instructionsHtml": "Section 2<p>Listen and answer questions 11–20.</p>",
        "groups": [
          {
            "id": "part-2-group-1",
            "type": "mcq",
            "selectCount": 2,
            "rubricHtml": "<h3>Questions 11 and 12</h3><p>Choose <strong>TWO</strong> letters, <strong>A–E</strong>.</p><p>Which <strong>TWO</strong> pieces of advice for the first week of an apprenticeship does the manager give?</p>",
