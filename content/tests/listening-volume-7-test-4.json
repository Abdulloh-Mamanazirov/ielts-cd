              {
                "number": 11,
                "textHtml": "&nbsp;People who act as hosts for Connections",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "are given a little money."
                  },
                  {
                    "letter": "B",
                    "textHtml": "do not receive payment."
                  },
                  {
                    "letter": "C",
                    "textHtml": "can apply for expenses."
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "&nbsp;Connections is for people from other countries who",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "have difficulty making friends."
                  },
                  {
                    "letter": "B",
                    "textHtml": "are looking for temporary work."
                  },
                  {
                    "letter": "C",
                    "textHtml": "can offer language support."
                  }
                ]
              },
              {
                "number": 13,
                "textHtml": "&nbsp;According to the speaker, what can a guest expect to do during their stay?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "cook food for their host family"
                  },
                  {
                    "letter": "B",
                    "textHtml": "explain their own family traditions."
                  },
