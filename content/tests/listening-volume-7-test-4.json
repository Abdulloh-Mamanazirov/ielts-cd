            "selectCount": 1,
            "questions": [
              {
                "number": 21,
                "textHtml": "&nbsp;Why is Beth unconvinced that allergies are linked to vitamin D deficiency?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "because people's diets have improved since the 1950s"
                  },
                  {
                    "letter": "B",
                    "textHtml": "because most people get enough vitamin D"
                  },
                  {
                    "letter": "C",
                    "textHtml": "because the evidence only applies in Britain"
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "&nbsp;Eliot explains that rising CO2 levels",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "will mean distribution of pollen over a wider area."
                  },
                  {
                    "letter": "B",
                    "textHtml": "are having less impact on pollen than milder winters."
                  },
                  {
                    "letter": "C",
                    "textHtml": "are responsible for higher quantities of pollen."
                  }
                ]
              },
              {
                "number": 23,
                "textHtml": "&nbsp;What does Beth say about seasonal changes?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "There is no clear short-term trend for the arrival of spring."
                  },
                  {
                    "letter": "B",
                    "textHtml": "In general, spring is likely to continue arriving early."
                  },
                  {
                    "letter": "C",
                    "textHtml": "Springs are becoming milder and longer."
                  }
                ]
              },
              {
                "number": 24,
                "textHtml": "&nbsp;What point is made about the plant ragweed?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "it is spreading to more countries."
                  },
                  {
                    "letter": "B",
                    "textHtml": "it is the most widespread cause of allergies globally."
                  },
                  {
                    "letter": "C",
                    "textHtml": "it causes the most severe type of allergy."
                  }
                ]
              },
              {
                "number": 25,
                "textHtml": "&nbsp;Why is tree pollen a more serious problem in cities?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "Trees produce more pollen there."
                  },
                  {
                    "letter": "B",
                    "textHtml": "There is less to absorb the tree pollen."
                  },
                  {
                    "letter": "C",
                    "textHtml": "There is not enough control over tree-planting."
                  }
                ]
              }
            ]
