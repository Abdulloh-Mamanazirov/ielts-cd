        "instructionsHtml": "Part 3<p>Listen and answer questions 21–30.</p>",
        "groups": [
          {
            "id": "part-3-group-1",
            "type": "completion",
            "rubricHtml": "<h3>Questions 21–26</h3><p>Complete the notes below.</p><p>Write <strong>ONE WORD ONLY</strong> for each answer.</p>",
            "selectCount": 1,
            "maxWords": 1,
            "bodyHtml": "<div class=\"summary\"><div class=\"summary-title\">What Hazel should analyse about items in newspapers:</div>\n<ul class=\"notes-list\">\n<li>what {{21}} the item is on</li>\n<li>the {{22}} of the item, including the headline</li>\n<li>any {{23}} accompanying the item</li>\n<li>the {{24}} of the item, e.g. what's made prominent</li>\n<li>the writer's main {{25}}</li>\n<li>the {{26}} the writer may make about the reader</li>\n</ul></div>"
          },
          {
            "id": "part-3-group-2",
            "type": "matching",
            "selectCount": 1,
            "rubricHtml": "<h3>Questions 27–30</h3><p>What does Hazel decide to do about each of the following types of articles?</p><p>Write the correct letter, <strong>A</strong>, <strong>B</strong> or <strong>C</strong>, next to Questions 27–30.</p>",
