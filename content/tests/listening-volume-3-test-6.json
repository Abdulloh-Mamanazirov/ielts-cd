              {
                "number": 26,
                "textHtml": "&nbsp;When people feed city pigeons, it causes them to",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "breed more successfully."
                  },
                  {
                    "letter": "B",
                    "textHtml": "become overweight."
                  },
                  {
                    "letter": "C",
                    "textHtml": "get sick."
                  }
                ]
              },
              {
                "number": 27,
                "textHtml": "&nbsp;The Melbourne city council are tackling their pigeon problem by",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "removing the pigeons from the city."
                  },
                  {
                    "letter": "B",
                    "textHtml": "scaring away pigeons."
                  },
                  {
                    "letter": "C",
                    "textHtml": "providing homes for the pigeons."
                  }
                ]
              },
              {
                "number": 28,
                "textHtml": "&nbsp;Jennifer and Adam agree the second stage of the council scheme is",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "expensive."
                  },
                  {
                    "letter": "B",
                    "textHtml": "cruel."
                  },
                  {
                    "letter": "C",
                    "textHtml": "ineffective."
                  }
                ]
              },
              {
                "number": 29,
                "textHtml": "&nbsp;What method of pigeon control was most successful in the city of Basel?",
