      {
        "number": 3,
        "title": "Part 3",
        "instructionsHtml": "<p>Listen and answer questions 21–30.</p>",
        "groups": [
          {
            "id": "part-3-group-1",
            "type": "mcq",
            "rubricHtml": "<p>Questions 21–25</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 21,
                "textHtml": "&nbsp;Amy and Mike agree that the greenstone tikis",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "take great skill to produce."
                  },
                  {
                    "letter": "B",
                    "textHtml": "are fascinating curved shapes."
                  },
                  {
                    "letter": "C",
                    "textHtml": "have interesting stories behind them."
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "&nbsp;According to Amy, why are so few genuine old tikis found on archaeological dig sites?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "Not many people know about them."
                  },
                  {
                    "letter": "B",
                    "textHtml": "They tend to be stolen by treasure hunters."
                  },
                  {
                    "letter": "C",
                    "textHtml": "The majority become inherited items."
                  }
                ]
              },
              {
                "number": 23,
                "textHtml": "&nbsp;The Maori people considered tikis to be",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "decorative items."
                  },
                  {
                    "letter": "B",
                    "textHtml": "religious objects."
                  },
                  {
                    "letter": "C",
                    "textHtml": "tribal symbols."
                  }
                ]
              },
              {
                "number": 24,
                "textHtml": "&nbsp;Tikis are classified into one type or the other by",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "where they originated."
                  },
                  {
                    "letter": "B",
                    "textHtml": "the materials used."
                  },
                  {
                    "letter": "C",
                    "textHtml": "the position of the body."
                  }
                ]
              },
              {
                "number": 25,
                "textHtml": "&nbsp;How can modern reproductions be easily distinguished from genuine Maori carvings?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "The materials differ."
                  },
                  {
                    "letter": "B",
                    "textHtml": "They are too regular in shape."
                  },
                  {
                    "letter": "C",
                    "textHtml": "They are of different sizes."
                  }
                ]
              }
            ]
