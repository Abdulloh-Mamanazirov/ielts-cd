            "questions": [
              {
                "number": 11,
                "textHtml": "Which <strong>TWO</strong> kinds of people are the scholarships intended for?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "people working as temporary staff"
                  },
                  {
                    "letter": "B",
                    "textHtml": "people with management experience"
                  },
                  {
                    "letter": "C",
                    "textHtml": "people straight from college"
                  },
                  {
                    "letter": "D",
                    "textHtml": "people with at least three years’ experience"
                  },
                  {
                    "letter": "E",
                    "textHtml": "people with or without qualifications"
                  }
                ]
              }
            ]
          },
          {
            "id": "part-2-group-2",
            "type": "mcq",
            "rubricHtml": "<p>Questions 13 and 14</p>",
            "selectCount": 2,
            "questions": [
              {
                "number": 13,
                "textHtml": "Which <strong>TWO</strong> things does Marie say about the hospitality industry in Scotland?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "It mainly attracts UK tourists."
                  },
                  {
                    "letter": "B",
                    "textHtml": "It pays high wages."
                  },
                  {
                    "letter": "C",
                    "textHtml": "It is very important for the Scottish economy."
                  },
                  {
                    "letter": "D",
                    "textHtml": "It is highly regarded by visitors."
                  },
                  {
                    "letter": "E",
                    "textHtml": "It is attracting a lot of investment."
                  }
                ]
              }
            ]
          },
          {
            "id": "part-2-group-3",
            "type": "mcq",
            "rubricHtml": "<p>Questions 15–20</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 15,
                "textHtml": "&nbsp;Why did Marie start working at the Rock Hotel?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "It was the only job available."
                  },
                  {
                    "letter": "B",
                    "textHtml": "She needed a job with flexible working hours."
                  },
                  {
                    "letter": "C",
                    "textHtml": "She wanted a job working with people."
                  }
                ]
              },
              {
                "number": 16,
                "textHtml": "&nbsp;What did the scholarship application process involve?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "giving a presentation"
                  },
                  {
                    "letter": "B",
                    "textHtml": "writing a report about the Rock Hotel"
                  },
                  {
                    "letter": "C",
                    "textHtml": "researching the role of hotel manager"
                  }
                ]
              },
              {
                "number": 17,
                "textHtml": "&nbsp;What does Marie say about the other winners she met?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "They were not as old as she expected."
                  },
                  {
                    "letter": "B",
                    "textHtml": "They were doing a variety of jobs in the hotel sector."
                  },
                  {
                    "letter": "C",
                    "textHtml": "Most of them had applied for scholarships before."
                  }
                ]
              },
              {
                "number": 18,
                "textHtml": "&nbsp;Marie says that at the Florida Beach Hotel, every member of staff",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "takes part in annual customer service training sessions."
                  },
                  {
                    "letter": "B",
                    "textHtml": "is responsible for providing an efficient service."
                  },
                  {
                    "letter": "C",
                    "textHtml": "is expected to interact with visitors."
                  }
                ]
              },
              {
                "number": 19,
                "textHtml": "&nbsp;What did Marie find out about people's attitude to visiting Scotland?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "Most people would be interested in visiting it."
                  },
                  {
                    "letter": "B",
                    "textHtml": "People knew a surprising amount about it."
                  },
                  {
                    "letter": "C",
                    "textHtml": "People only wanted to see a limited number of places."
                  }
                ]
              },
              {
                "number": 20,
                "textHtml": "&nbsp;What improvement has Marie introduced at the Rock Hotel?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "getting better feedback from customers"
                  },
                  {
                    "letter": "B",
                    "textHtml": "providing more information for customers"
                  },
                  {
                    "letter": "C",
                    "textHtml": "making contact with more customers"
                  }
                ]
              }
            ]
          }
