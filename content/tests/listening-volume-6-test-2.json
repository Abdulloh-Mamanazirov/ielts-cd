            "rubricHtml": "<p>Questions 11–15</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 11,
                "textHtml": "&nbsp;What does the manager say about accommodation?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "The backpackers' hostel is full."
                  },
                  {
                    "letter": "B",
                    "textHtml": "The motel is close to the farm."
                  },
                  {
                    "letter": "C",
                    "textHtml": "The campground is cheap."
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "&nbsp;The weather this summer has been",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "perfect for growing fruit."
                  },
                  {
                    "letter": "B",
                    "textHtml": "worse than last year."
                  },
                  {
                    "letter": "C",
                    "textHtml": "hard to predict accurately."
                  }
                ]
              },
              {
                "number": 13,
                "textHtml": "&nbsp;The manager says that tractor drivers",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "require an appropriate licence."
                  },
                  {
                    "letter": "B",
                    "textHtml": "need previous orchard experience."
                  },
                  {
                    "letter": "C",
                    "textHtml": "must be over 18 years old."
                  }
                ]
              },
              {
                "number": 14,
                "textHtml": "&nbsp;Working inside the shed",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "may be rather hot."
                  },
                  {
                    "letter": "B",
                    "textHtml": "can be noisy at times."
                  },
                  {
                    "letter": "C",
                    "textHtml": "will often be dirty."
                  }
                ]
              },
              {
                "number": 15,
                "textHtml": "&nbsp;What final advice does the manager give?",
