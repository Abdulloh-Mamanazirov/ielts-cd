            "questions": [
              {
                "number": 21,
                "textHtml": "&nbsp;According to Liz, Stone Point played a key role in local history because",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "it was used for defence or attack purposes."
                  },
                  {
                    "letter": "B",
                    "textHtml": "it was the landing point for the first Maori settlers."
                  },
                  {
                    "letter": "C",
                    "textHtml": "it was developed as a commercial port."
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "&nbsp;Scott and Liz agree that Maori originally chose to inhabit Stone Point because of",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "its rich soil."
                  },
                  {
                    "letter": "B",
                    "textHtml": "the supply of fish."
                  },
                  {
                    "letter": "C",
                    "textHtml": "available building materials."
                  }
                ]
              },
              {
                "number": 23,
                "textHtml": "&nbsp;Scott and Liz agree that using Maori terminology in their presentation",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "will be of interest to international students."
                  },
                  {
                    "letter": "B",
                    "textHtml": "is required as a component of their research."
                  },
                  {
                    "letter": "C",
                    "textHtml": "would be best avoided."
                  }
                ]
              },
              {
                "number": 24,
                "textHtml": "&nbsp;When Scott mentions the engines at Stone Point, Liz advises him to",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "focus on the human aspect instead."
                  },
                  {
                    "letter": "B",
                    "textHtml": "check the accuracy of specific dates."
                  },
                  {
                    "letter": "C",
                    "textHtml": "explain complex technical language."
                  }
                ]
              }
