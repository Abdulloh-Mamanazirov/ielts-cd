            "selectCount": 1,
            "questions": [
              {
                "number": 21,
                "textHtml": "&nbsp;Adele read the article about Bitublocks because",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "it'll help her write an assignment."
                  },
                  {
                    "letter": "B",
                    "textHtml": "she has to present it at a seminar."
                  },
                  {
                    "letter": "C",
                    "textHtml": "it's on her dissertation topic."
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "&nbsp;What does Adele think is the most innovative aspect of the manufacture of Bitublocks?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "It uses entirely recycled materials."
                  },
                  {
                    "letter": "B",
                    "textHtml": "It does not involve a chemical reaction."
                  },
                  {
                    "letter": "C",
                    "textHtml": "It is such a simple process."
                  }
                ]
              },
              {
                "number": 23,
                "textHtml": "&nbsp;Ray was surprised to read that the Bitublocks are so",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "stable."
                  },
                  {
                    "letter": "B",
                    "textHtml": "light."
                  },
                  {
                    "letter": "C",
                    "textHtml": "absorbent."
                  }
                ]
              },
              {
                "number": 24,
                "textHtml": "&nbsp;What do both Adele and Ray say about the manufacture of Bitublocks?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "Existing methods are used."
                  },
                  {
                    "letter": "B",
                    "textHtml": "Cheap materials are used."
                  },
                  {
                    "letter": "C",
                    "textHtml": "Only local materials are used."
                  }
                ]
              },
              {
                "number": 25,
                "textHtml": "&nbsp;What insight did Ray get from reading about the hospital building?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "how quickly UK building projects are growing"
                  },
                  {
                    "letter": "B",
                    "textHtml": "how poor UK construction materials are"
                  },
                  {
                    "letter": "C",
                    "textHtml": "how much material the UK construction industry uses"
                  }
                ]
              },
              {
                "number": 26,
                "textHtml": "&nbsp;Adele thinks the research into the hospital was included in the article to show",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "how much recycled material is currently used."
                  },
                  {
                    "letter": "B",
                    "textHtml": "ways to improve the levels of recycling."
                  },
                  {
                    "letter": "C",
                    "textHtml": "problems caused when using recycled materials."
                  }
                ]
              }
            ]
