            "questions": [
              {
                "number": 21,
                "textHtml": "&nbsp;According to Jack, why did Samuel Prout never become very famous?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "His output was very limited."
                  },
                  {
                    "letter": "B",
                    "textHtml": "He was seen as out of fashion."
                  },
                  {
                    "letter": "C",
                    "textHtml": "His work never had a major exhibition."
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "&nbsp;Dr Rubin and Jack agree that many of Prout's problems were caused by",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "poor health."
                  },
                  {
                    "letter": "B",
                    "textHtml": "jealous colleagues."
                  },
                  {
                    "letter": "C",
                    "textHtml": "an unhappy marriage."
                  }
                ]
              },
              {
                "number": 23,
                "textHtml": "&nbsp;How did Prout learn painting?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "His father taught him."
                  },
                  {
                    "letter": "B",
                    "textHtml": "He went to art galleries."
                  },
                  {
                    "letter": "C",
                    "textHtml": "He copied pictures."
                  }
                ]
              },
              {
                "number": 24,
                "textHtml": "&nbsp;What point does Jack make about Prout's style?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "Prout used different styles simultaneously."
                  },
                  {
                    "letter": "B",
                    "textHtml": "Many other artists had a similar style."
                  },
                  {
                    "letter": "C",
                    "textHtml": "Prout's style developed throughout his career."
                  }
                ]
              },
              {
                "number": 25,
                "textHtml": "&nbsp;What did John Ruskin admire about Prout's paintings?",
