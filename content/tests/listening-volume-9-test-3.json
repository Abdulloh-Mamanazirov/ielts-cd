      {
        "number": 3,
        "title": "Part 3",
        "instructionsHtml": "<p>Listen and answer questions 21–30.</p>",
        "groups": [
          {
            "id": "part-3-group-1",
            "type": "mcq",
            "rubricHtml": "<p>Questions 21–26</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 21,
                "textHtml": "&nbsp;Ed is giving the voice coaching workshop in order to get",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "a new job."
                  },
                  {
                    "letter": "B",
                    "textHtml": "a qualification."
                  },
                  {
                    "letter": "C",
                    "textHtml": "a promotion."
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "&nbsp;According to Fiona, the seating pattern that Ed chooses",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "should be illustrated visually."
                  },
                  {
                    "letter": "B",
                    "textHtml": "has to be explained in detail."
                  },
                  {
                    "letter": "C",
                    "textHtml": "is not particularly important."
                  }
                ]
              },
              {
                "number": 23,
                "textHtml": "&nbsp;Fiona and Ed agree that in the first activity, the students",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "may feel uncomfortable."
                  },
                  {
                    "letter": "B",
                    "textHtml": "like to make group contact."
                  },
                  {
                    "letter": "C",
                    "textHtml": "must focus on themselves."
                  }
                ]
              },
              {
                "number": 24,
                "textHtml": "&nbsp;Fiona and Ed agree that in the second activity, Ed should",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "insist which students work together."
                  },
                  {
                    "letter": "B",
                    "textHtml": "tell students to prepare a speech."
                  },
                  {
                    "letter": "C",
                    "textHtml": "include a focus on breath control."
                  }
                ]
              },
              {
                "number": 25,
                "textHtml": "&nbsp;What does Fiona suggest about working in a big space?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "It could be outside or inside."
                  },
                  {
                    "letter": "B",
                    "textHtml": "It is best to go to somewhere like a park."
                  },
                  {
                    "letter": "C",
                    "textHtml": "It is useful for getting actors to shout."
                  }
                ]
              },
              {
                "number": 26,
                "textHtml": "&nbsp;What does Fiona think of Ed's selection of texts?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "It should include more classical texts."
                  },
                  {
                    "letter": "B",
                    "textHtml": "It needs to focus on a single emotion."
                  },
                  {
                    "letter": "C",
                    "textHtml": "It has to cover a wider range."
                  }
                ]
              }
            ]
