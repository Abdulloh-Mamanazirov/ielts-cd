        "number": 1,
        "title": "Part 1",
        "instructionsHtml": "<p>Listen and answer questions 1–10.</p>",
        "groups": [
          {
            "id": "part-1-group-1",
            "type": "mcq",
            "rubricHtml": "<p>Questions 1–8</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 1,
                "textHtml": "&nbsp;The centre has enough accommodation for",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "18 people"
                  },
                  {
                    "letter": "B",
                    "textHtml": "20 people"
                  },
                  {
                    "letter": "C",
                    "textHtml": "38 people"
                  }
                ]
              },
              {
                "number": 2,
                "textHtml": "&nbsp;The meeting room is currently",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "unavailable"
                  },
                  {
                    "letter": "B",
                    "textHtml": "flooded"
                  },
                  {
                    "letter": "C",
                    "textHtml": "booked"
                  }
                ]
              },
              {
                "number": 3,
                "textHtml": "&nbsp;Visitors must tell the centre in advance if they want to",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "use the centre's kitchen."
                  },
                  {
                    "letter": "B",
                    "textHtml": "have meals cooked for them."
                  },
                  {
                    "letter": "C",
                    "textHtml": "eat at restaurants outside."
                  }
                ]
              },
              {
                "number": 4,
                "textHtml": "&nbsp;All visitors on the tour of the farm can",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "get information about organic farming."
                  },
                  {
                    "letter": "B",
                    "textHtml": "help to feed the animals."
                  },
                  {
                    "letter": "C",
                    "textHtml": "watch a tractor demonstration."
                  }
                ]
              },
              {
                "number": 5,
                "textHtml": "&nbsp;On the survival course people have to",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "learn to use a map."
                  },
                  {
                    "letter": "B",
                    "textHtml": "find their own food."
                  },
                  {
                    "letter": "C",
                    "textHtml": "run through woodland."
                  }
                ]
              },
              {
                "number": 6,
                "textHtml": "&nbsp;From the centre it is easy to walk to",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "Exmoor National Park."
                  },
                  {
                    "letter": "B",
                    "textHtml": "the beach."
                  },
                  {
                    "letter": "C",
                    "textHtml": "a cycling route."
                  }
                ]
              },
              {
                "number": 7,
                "textHtml": "&nbsp;If the weather is bad visitors can go to a",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "cinema."
                  },
                  {
                    "letter": "B",
                    "textHtml": "theatre."
                  },
                  {
                    "letter": "C",
                    "textHtml": "museum."
                  }
                ]
              },
              {
                "number": 8,
                "textHtml": "&nbsp;Groups who wish to stay at the centre must pay",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "part of the cost in advance."
                  },
                  {
                    "letter": "B",
                    "textHtml": "all of the cost in advance."
                  },
                  {
                    "letter": "C",
                    "textHtml": "all of the cost on arrival."
                  }
                ]
              }
            ]
          },
          {
            "id": "part-1-group-2",
            "type": "completion",
            "rubricHtml": "<p>Questions 9 and 10</p>",
            "selectCount": 1,
            "bodyHtml": "<p>Complete the notes below. Write <strong>ONE WORD AND/OR A NUMBER</strong> for each answer.</p><div><div class=\"notes-title\"><strong>Address</strong></div><ul><li>Winsham Farm</li><li>{{9}} Rd</li><li>Near Sherborne</li><li>Postcode: {{10}}</li></ul></div>",
            "maxWords": 3
