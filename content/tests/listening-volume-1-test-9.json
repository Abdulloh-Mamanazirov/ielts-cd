                  {
                    "letter": "B",
                    "textHtml": "&nbsp; of different shapes"
                  },
                  {
                    "letter": "C",
                    "textHtml": "&nbsp; for many famous people"
                  }
                ]
              },
              {
                "number": 17,
                "textHtml": "&nbsp;People's favourite biscuit used to be",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "&nbsp; an unsweetened one"
                  },
                  {
                    "letter": "B",
                    "textHtml": "&nbsp; one covered in chocolate"
                  },
                  {
                    "letter": "C",
                    "textHtml": "&nbsp; one filled with cream"
                  }
                ]
              },
              {
                "number": 18,
                "textHtml": "&nbsp;The hands-on activity allows people to",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "&nbsp; make some biscuits"
                  },
                  {
                    "letter": "B",
                    "textHtml": "&nbsp; taste some of the biscuits"
                  },
                  {
                    "letter": "C",
                    "textHtml": "&nbsp; pack a biscuit tin"
                  }
                ]
              }
            ]
          },
