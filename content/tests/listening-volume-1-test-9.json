      {
        "number": 2,
        "title": "Part 2",
        "instructionsHtml": "<p>Listen and answer questions 11–20.</p>",
        "groups": [
          {
            "id": "part-2-group-1",
            "type": "mcq",
            "rubricHtml": "<p>Questions 11–18: Choose the correct letter, A, B or C.</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 11,
                "textHtml": "&nbsp;The Heritage Clothes Exhibition was put together by",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "&nbsp; museum staff"
                  },
                  {
                    "letter": "B",
                    "textHtml": "&nbsp; local residents"
                  },
                  {
                    "letter": "C",
                    "textHtml": "&nbsp; clothing manufacturers"
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "&nbsp;The photographs show the clothes worn by",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "&nbsp; their owners"
                  },
                  {
                    "letter": "B",
                    "textHtml": "&nbsp; professional models"
                  },
                  {
                    "letter": "C",
                    "textHtml": "&nbsp; design students"
                  }
                ]
              },
              {
                "number": 13,
                "textHtml": "&nbsp;The exhibition called \"Toys from the Past\" is",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "&nbsp; displayed in a new gallery"
                  },
                  {
                    "letter": "B",
                    "textHtml": "&nbsp; on show for a limited time"
                  },
                  {
                    "letter": "C",
                    "textHtml": "&nbsp; specially aimed at children"
                  }
                ]
              },
              {
                "number": 14,
                "textHtml": "&nbsp;Visitors to \"Toys from the Past\" are recommended to",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "&nbsp; play with the toy trains"
                  },
                  {
                    "letter": "B",
                    "textHtml": "&nbsp; look at all the dolls"
                  },
                  {
                    "letter": "C",
                    "textHtml": "&nbsp; see the board"
                  }
                ]
              },
              {
                "number": 15,
                "textHtml": "&nbsp;The miniature toys are",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "&nbsp; made by the museum"
