            "bodyHtml": "<div><div class=\"notes-title\"><strong>Sports Photography Course Registration</strong></div><p><strong>Caller's name:</strong> Chris Johnson</p><p><strong>The level of the selected course:</strong> suitable for {{1}}</p><p><strong>How to register:</strong> no need for an {{2}}</p><p><strong>Cost:</strong> {{3}} $</p><p><strong>Date available:</strong> next course, beginning {{4}}</p><p><strong>Telephone number:</strong> {{5}}</p><p><strong>Requirement:</strong> bring two photos of different {{6}}</p></div>",
            "maxWords": 2
