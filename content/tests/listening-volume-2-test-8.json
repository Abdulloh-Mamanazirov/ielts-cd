          {
            "id": "part-2-group-1",
            "type": "mcq",
            "rubricHtml": "<p>Questions 11–16 <span style=\"font-weight:400;\">(Moving Office)</span></p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 11,
                "textHtml": "&nbsp;What reason does the manager give for moving to a new office building?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "to have more space"
                  },
                  {
                    "letter": "B",
                    "textHtml": "to pay less rent"
                  },
                  {
                    "letter": "C",
                    "textHtml": "to be in a central location"
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "&nbsp;What is best about the new office building?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the air-conditioning system"
                  },
                  {
                    "letter": "B",
                    "textHtml": "the amount of natural light"
                  },
                  {
                    "letter": "C",
                    "textHtml": "the low level of noise"
                  }
                ]
              },
              {
                "number": 13,
                "textHtml": "&nbsp;When will the office move take place?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "after the sales conference"
                  },
                  {
                    "letter": "B",
                    "textHtml": "after the end of the tax year"
                  },
                  {
                    "letter": "C",
                    "textHtml": "after the annual holiday period"
                  }
                ]
              },
              {
                "number": 14,
                "textHtml": "&nbsp;What information about the new location is already on the company website?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "where to park"
                  },
                  {
                    "letter": "B",
                    "textHtml": "places to eat"
                  },
                  {
                    "letter": "C",
                    "textHtml": "public transport"
                  }
                ]
              },
              {
                "number": 15,
                "textHtml": "&nbsp;What practical thing must staff do now?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "give details of damaged furniture"
                  },
                  {
                    "letter": "B",
                    "textHtml": "throw away unnecessary papers"
                  },
                  {
                    "letter": "C",
                    "textHtml": "take home personal items"
                  }
                ]
              },
              {
                "number": 16,
                "textHtml": "&nbsp;Staff will need to put folders containing confidential details",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "into packing boxes"
                  },
                  {
                    "letter": "B",
                    "textHtml": "into grey plastic bags"
                  },
                  {
                    "letter": "C",
                    "textHtml": "into new filing cabinets"
                  }
                ]
              }
