                  },
                  {
                    "letter": "C",
                    "textHtml": "do not lean to one side"
                  },
                  {
                    "letter": "D",
                    "textHtml": "use handles"
                  },
                  {
                    "letter": "E",
                    "textHtml": "stand with feet apart"
                  }
                ]
              }
            ]
