            "type": "completion",
            "rubricHtml": "<h3>Questions 1–10</h3><p>Complete the form below. Write <strong>ONE WORD ONLY</strong> for each answer.</p>",
            "selectCount": 1,
            "bodyHtml": "<div class=\"summary-title\">Survey about shopping in Broadbeach</div><div class=\"form-row\"><span class=\"form-label\">Name:</span><span class=\"form-value\">Martyn {{1}}</span></div><div class=\"form-row\"><span class=\"form-label\">Today’s journey to Broadbeach town centre:</span><span class=\"form-value\">used his {{2}}</span></div><div class=\"form-row\"><span class=\"form-label\">Purpose of today’s trip:</span><ul class=\"notes-list\"><li>has visited the {{3}}</li><li>looking for a new {{4}}</li><li>collecting {{5}} (after repair)</li></ul></div><div class=\"form-row\"><span class=\"form-label\">Preferred day for shopping:</span><span class=\"form-value\"> {{6}}</span></div><div>Opinions about shopping in the town centre</div><ul class=\"notes-list\"><li>Finds the service in shops is excellent</li><li>Thinks there are too many places selling {{7}}</li><li>Would like more places to buy {{8}}</li></ul><div>Opinions about new out-of-town Shopping Centre</div><ul class=\"notes-list\"><li>Likes the {{9}} best</li><li>Believes the {{10}} is unnecessary</li></ul>",
            "maxWords": 1
          }
        ]
      },
