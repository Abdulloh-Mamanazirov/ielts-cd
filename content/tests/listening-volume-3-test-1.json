        "title": "Part 3",
        "instructionsHtml": "<p>Listen and answer questions 21–30.</p>",
        "groups": [
          {
            "id": "part-3-group-1",
            "type": "mcq",
            "rubricHtml": "<p>Questions 21–25 <span style=\"font-weight:400;\">(The Value Survey on House Prices)</span></p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 21,
                "textHtml": "&nbsp;James and Anna's Value Survey measured the cost of houses by calculating",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the total price of building a new house."
                  },
                  {
                    "letter": "B",
                    "textHtml": "the size of house a typical family can afford."
                  },
                  {
                    "letter": "C",
                    "textHtml": "the price of houses compared to average income."
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "&nbsp;Anna says the Value Survey is unusual because",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "it compares prices in different cities."
                  },
                  {
                    "letter": "B",
                    "textHtml": "it is the oldest survey of its kind."
                  },
                  {
                    "letter": "C",
                    "textHtml": "it publishes its results annually."
                  }
                ]
              },
              {
                "number": 23,
                "textHtml": "&nbsp;The students decide that New Zealand house prices are high because of",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the cost of construction materials."
                  },
                  {
                    "letter": "B",
                    "textHtml": "the shortage of builders."
                  },
                  {
                    "letter": "C",
                    "textHtml": "the rules concerning land use."
                  }
                ]
              },
              {
                "number": 24,
                "textHtml": "&nbsp;When the students talk about transport, they are",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "concerned there is no plan."
                  },
                  {
                    "letter": "B",
                    "textHtml": "worried about rising costs."
                  },
                  {
                    "letter": "C",
                    "textHtml": "alarmed by increasing congestion."
                  }
                ]
              },
              {
                "number": 25,
                "textHtml": "&nbsp;The students agree that the next Value Survey will",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "compare a wider number of locations."
                  },
                  {
                    "letter": "B",
                    "textHtml": "indicate a future trend in house prices."
                  },
                  {
                    "letter": "C",
                    "textHtml": "advise against regulation of house prices."
                  }
                ]
              }
            ]
          },
