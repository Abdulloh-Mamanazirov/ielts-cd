            "type": "mcq",
            "rubricHtml": "<p>Questions 11–15</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 11,
                "textHtml": "&nbsp;Jim says that in the Iron Age village",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "he is sometimes cold at night."
                  },
                  {
                    "letter": "B",
                    "textHtml": "he always gets up early."
                  },
                  {
                    "letter": "C",
                    "textHtml": "he has time to himself."
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "&nbsp;What does Jim say about the food they eat in the village?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "It takes time to prepare."
                  },
                  {
                    "letter": "B",
                    "textHtml": "It is difficult to get used to."
                  },
                  {
                    "letter": "C",
                    "textHtml": "It has to be eaten quickly."
                  }
                ]
              },
              {
                "number": 13,
                "textHtml": "&nbsp;Jim says that at the evening meal",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "they are sometimes too tired to eat."
                  },
                  {
                    "letter": "B",
                    "textHtml": "they mainly have fruit and berries."
                  },
                  {
                    "letter": "C",
                    "textHtml": "they talk about what they've done."
                  }
                ]
              },
              {
                "number": 14,
                "textHtml": "&nbsp;The most important job for the blacksmiths is",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "to mend broken tools and implements."
                  },
                  {
                    "letter": "B",
                    "textHtml": "to maintain a good source of heat."
                  },
                  {
                    "letter": "C",
                    "textHtml": "to collect sufficient firewood."
                  }
                ]
              },
              {
                "number": 15,
                "textHtml": "&nbsp;Jim likes the fact that in the village, people",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "do varied activities."
                  },
                  {
                    "letter": "B",
                    "textHtml": "share their knowledge."
                  },
                  {
                    "letter": "C",
                    "textHtml": "get a lot of exercise."
                  }
                ]
              }
            ]
