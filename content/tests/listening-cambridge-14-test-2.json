          {
            "id": "part-1-group-1",
            "type": "completion",
            "rubricHtml": "<h3>Questions 1–10</h3><p>Complete the notes below.</p><p>Write <strong>ONE WORD AND/OR A NUMBER</strong> for each answer.</p>",
            "selectCount": 1,
            "maxWords": 3,
            "bodyHtml": "<table class=\"q-table\"><caption class=\"summary-title\">Total Health Clinic</caption>\n<tbody>\n<tr><td colspan=\"2\"><strong>PATIENT DETAILS</strong></td></tr>\n<tr><td colspan=\"2\"><strong>Personal information</strong></td></tr>\n<tr><td>Name</td><td><em>Example</em>&nbsp;&nbsp;Julie Anne <u>Garcia</u></td></tr>\n<tr><td>Contact phone</td><td>{{1}}</td></tr>\n<tr><td>Date of birth</td><td>{{2}}, 1992</td></tr>\n<tr><td>Occupation</td><td>works as a {{3}}</td></tr>\n<tr><td>Insurance company</td><td>{{4}} Life Insurance</td></tr>\n<tr><td colspan=\"2\"><strong>Details of the problem</strong></td></tr>\n<tr><td>Type of problem</td><td>pain in her left {{5}}</td></tr>\n<tr><td>When it began</td><td>{{6}} ago</td></tr>\n<tr><td>Action already taken</td><td>has taken painkillers and applied ice</td></tr>\n<tr><td colspan=\"2\"><strong>Other information</strong></td></tr>\n<tr><td>Sports played</td><td>belongs to a {{7}} club<br>goes {{8}} regularly</td></tr>\n<tr><td>Medical history</td><td>injured her {{9}} last year<br>no allergies<br>no regular medication apart from {{10}}</td></tr>\n</tbody></table>"
          }
        ]
      },
