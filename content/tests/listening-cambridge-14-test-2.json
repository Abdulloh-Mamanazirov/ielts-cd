        "number": 2,
        "instructionsHtml": "Section 2<p>Listen and answer questions 11–20.</p>",
        "groups": [
          {
            "id": "part-2-group-1",
            "type": "mcq",
            "selectCount": 1,
            "rubricHtml": "<h3>Questions 11–15</h3><p>Choose the correct letter, <strong>A</strong>, <strong>B</strong> or <strong>C</strong>.</p><p><strong>Visit to Branley Castle</strong></p>",
            "questions": [
              {
                "number": 11,
                "textHtml": "Before Queen Elizabeth I visited the castle in 1576,",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "repairs were carried out to the guest rooms."
                  },
                  {
                    "letter": "B",
                    "textHtml": "a new building was constructed for her."
                  },
                  {
                    "letter": "C",
                    "textHtml": "a fire damaged part of the main hall."
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "In 1982, the castle was sold to",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the government."
                  },
                  {
                    "letter": "B",
                    "textHtml": "the Fenys family."
                  },
                  {
                    "letter": "C",
                    "textHtml": "an entertainment company."
                  }
                ]
              },
              {
                "number": 13,
                "textHtml": "In some of the rooms, visitors can",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "speak to experts on the history of the castle."
                  },
                  {
                    "letter": "B",
                    "textHtml": "interact with actors dressed as famous characters."
                  },
                  {
                    "letter": "C",
                    "textHtml": "see models of historical figures moving and talking."
                  }
                ]
              },
              {
                "number": 14,
                "textHtml": "In the castle park, visitors can",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "see an 800-year-old tree."
                  },
                  {
                    "letter": "B",
                    "textHtml": "go to an art exhibition."
                  },
                  {
                    "letter": "C",
                    "textHtml": "visit a small zoo."
                  }
                ]
              },
              {
                "number": 15,
                "textHtml": "At the end of the visit, the group will have",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "afternoon tea in the conservatory."
                  },
                  {
                    "letter": "B",
                    "textHtml": "the chance to meet the castle's owners."
                  },
                  {
                    "letter": "C",
                    "textHtml": "a photograph together on the Great Staircase."
                  }
                ]
              }
            ]
