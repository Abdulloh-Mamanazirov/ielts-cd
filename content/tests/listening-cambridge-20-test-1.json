      {
        "number": 3,
        "instructionsHtml": "Part 3<p>Listen and answer questions 21–30.</p>",
        "groups": [
          {
            "id": "part-3-group-1",
            "type": "mcq",
            "selectCount": 2,
            "rubricHtml": "<h3>Questions 21 and 22</h3><p>Choose <strong>TWO</strong> letters, <strong>A–E</strong>.</p><p>Which <strong>TWO</strong> things do the students both believe are responsible for the increase in loneliness?</p>",
            "questions": [
              {
                "number": 21,
                "textHtml": "Which <strong>TWO</strong> things do the students both believe are responsible for the increase in loneliness?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "social media"
                  },
                  {
                    "letter": "B",
                    "textHtml": "smaller nuclear families"
                  },
                  {
                    "letter": "C",
                    "textHtml": "urban design"
                  },
                  {
                    "letter": "D",
                    "textHtml": "longer lifespans"
                  },
                  {
                    "letter": "E",
                    "textHtml": "a mobile workforce"
                  }
                ]
              }
            ]
          },
          {
            "id": "part-3-group-2",
            "type": "mcq",
            "selectCount": 2,
            "rubricHtml": "<h3>Questions 23 and 24</h3><p>Choose <strong>TWO</strong> letters, <strong>A–E</strong>.</p><p>Which <strong>TWO</strong> health risks associated with loneliness do the students agree are based on solid evidence?</p>",
            "questions": [
              {
                "number": 23,
                "textHtml": "Which <strong>TWO</strong> health risks associated with loneliness do the students agree are based on solid evidence?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "a weakened immune system"
                  },
                  {
                    "letter": "B",
                    "textHtml": "dementia"
