          {
            "id": "part-2-group-3",
            "type": "mcq",
            "selectCount": 2,
            "rubricHtml": "<h3>Questions 19 and 20</h3><p>Choose <strong>TWO</strong> letters, <strong>A–E</strong>.</p><p>Which <strong>TWO</strong> optional after-school lessons are new?</p>",
            "questions": [
              {
                "number": 19,
                "textHtml": "Which <strong>TWO</strong> optional after-school lessons are new?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "swimming"
                  },
                  {
                    "letter": "B",
                    "textHtml": "piano"
                  },
                  {
