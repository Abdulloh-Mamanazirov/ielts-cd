      {
        "number": 1,
        "instructionsHtml": "Part 1<p>Listen and answer questions 1–10.</p>",
        "groups": [
          {
            "id": "part-1-group-1",
            "type": "completion",
            "rubricHtml": "<h3>Questions 1–10</h3><p>Complete the notes below.</p><p>Write <strong>ONE WORD AND/OR A NUMBER</strong> for each answer.</p>",
            "selectCount": 1,
            "maxWords": 2,
            "bodyHtml": "<div class=\"summary\"><div class=\"summary-title\">Copying photos to digital format</div>\n<p><strong>Name of company: Picturerep</strong></p>\n<p class=\"sub-head\">Requirements</p>\n<ul class=\"notes-list\">\n<li>Maximum size of photos is 30 cm, minimum size 4 cm.</li>\n<li>Photos must not be in a {{1}} or an album.</li>\n</ul>\n<p class=\"sub-head\">Cost</p>\n<ul class=\"notes-list\">\n<li>The cost for 360 photos is £{{2}} (including one disk).</li>\n<li>Before the completed order is sent, {{3}} is required.</li>\n</ul>\n<p class=\"sub-head\">Services included in the price</p>\n<ul class=\"notes-list\">\n<li>Photos can be placed in a folder, e.g. with the name {{4}}.</li>\n<li>The {{5}} and contrast can be improved if necessary.</li>\n<li>Photos which are very fragile will be scanned by {{6}}.</li>\n</ul>\n<p class=\"sub-head\">Special restore service (costs extra)</p>\n<ul class=\"notes-list\">\n<li>It may be possible to remove an object from a photo, or change the {{7}}.</li>\n<li>A photo which is not correctly in {{8}} cannot be fixed.</li>\n</ul>\n<p class=\"sub-head\">Other information</p>\n<ul class=\"notes-list\">\n<li>Orders are completed within {{9}}.</li>\n<li>Send the photos in a box (not {{10}}).</li>\n</ul></div>"
          }
        ]
      },
      {
        "number": 2,
        "instructionsHtml": "Part 2<p>Listen and answer questions 11–20.</p>",
        "groups": [
          {
            "id": "part-2-group-1",
            "type": "mcq",
            "selectCount": 1,
            "rubricHtml": "<h3>Questions 11–15</h3><p>Choose the correct letter, <strong>A</strong>, <strong>B</strong> or <strong>C</strong>.</p>",
            "questions": [
              {
                "number": 11,
                "textHtml": "Dartfield House school used to be",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "a tourist information centre."
                  },
                  {
                    "letter": "B",
                    "textHtml": "a private home."
                  },
                  {
                    "letter": "C",
                    "textHtml": "a local council building."
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "What is planned with regard to the lower school?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "All buildings on the main site will be improved."
                  },
                  {
                    "letter": "B",
                    "textHtml": "The lower school site will be used for new homes."
                  },
                  {
                    "letter": "C",
                    "textHtml": "Additional school buildings will be constructed on the lower school site."
                  }
                ]
              },
              {
                "number": 13,
                "textHtml": "The catering has been changed because of",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "long queuing times."
                  },
                  {
                    "letter": "B",
                    "textHtml": "changes to the school timetable."
                  },
                  {
                    "letter": "C",
                    "textHtml": "dissatisfaction with the menus."
                  }
                ]
              },
              {
                "number": 14,
                "textHtml": "Parents are asked to",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "help their children to decide in advance which serving point to use."
                  },
                  {
                    "letter": "B",
                    "textHtml": "make sure their children have enough money for food."
                  },
                  {
                    "letter": "C",
                    "textHtml": "advise their children on healthy food to eat."
                  }
                ]
              },
              {
                "number": 15,
                "textHtml": "What does the speaker say about the existing canteen?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "Food will still be served there."
                  },
                  {
                    "letter": "B",
                    "textHtml": "Only staff will have access to it."
                  },
                  {
                    "letter": "C",
                    "textHtml": "Pupils can take their food into it."
                  }
                ]
              }
            ]
          },
          {
            "id": "part-2-group-2",
            "type": "matching",
            "selectCount": 1,
            "rubricHtml": "<h3>Questions 16–18</h3><p>What comment does the speaker make about each of the following serving points in the Food Hall?</p><p>Choose <strong>THREE</strong> answers from the box and write the correct letter, <strong>A–D</strong>, next to Questions 16–18.</p>",
            "wordBank": [
              {
                "letter": "A",
                "textHtml": "pupils help to plan menus"
              },
              {
                "letter": "B",
                "textHtml": "only vegetarian food"
              },
              {
                "letter": "C",
                "textHtml": "different food every week"
              },
              {
                "letter": "D",
                "textHtml": "daily change in menu"
              }
            ],
            "questions": [
