                  {
                    "letter": "B",
                    "textHtml": "Children will continue to learn to write by hand"
                  },
                  {
                    "letter": "C",
                    "textHtml": "People will dislike handwriting on digital devices"
                  }
                ]
              },
              {
                "number": 29,
