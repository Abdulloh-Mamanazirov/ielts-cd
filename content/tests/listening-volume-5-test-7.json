                  {
                    "letter": "A",
                    "textHtml": "to have more space"
                  },
                  {
                    "letter": "B",
                    "textHtml": "to pay less rent"
                  },
                  {
                    "letter": "C",
                    "textHtml": "be in a central location"
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "&nbsp;What is best about the new office building?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the air-conditioning system"
                  },
                  {
                    "letter": "B",
                    "textHtml": "the amount of natural light"
                  },
                  {
                    "letter": "C",
                    "textHtml": "the low level of noise"
