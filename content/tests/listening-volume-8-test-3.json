          {
            "id": "part-3-group-3",
            "type": "mcq",
            "rubricHtml": "<p>Questions 26–30</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 26,
                "textHtml": "&nbsp;What does Sylvia say about people's knowledge of renewable energy?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "Many people know little about it."
                  },
                  {
                    "letter": "B",
                    "textHtml": "People understand it because it has been in the news recently."
                  },
                  {
                    "letter": "C",
                    "textHtml": "People are eager to find out more about it."
                  }
                ]
              },
              {
                "number": 27,
                "textHtml": "&nbsp;What do Sylvia and Greg decide to ask about traditional energy consumption?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the best way of preventing pollution"
                  },
                  {
                    "letter": "B",
                    "textHtml": "possible future developments"
                  },
                  {
                    "letter": "C",
                    "textHtml": "how expensive people find it"
                  }
                ]
              },
              {
                "number": 28,
                "textHtml": "&nbsp;What does Greg say about nuclear power?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "It is not important for their survey."
                  },
                  {
                    "letter": "B",
                    "textHtml": "People today have a positive attitude towards it."
                  },
                  {
                    "letter": "C",
                    "textHtml": "Some people think it is unsafe."
                  }
                ]
              },
              {
                "number": 29,
                "textHtml": "&nbsp;What do Sylvia and Greg agree about the cost of renewable energy?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "Prices will drop in the future."
                  },
                  {
                    "letter": "B",
                    "textHtml": "People won't pay the high price."
                  },
                  {
                    "letter": "C",
                    "textHtml": "The benefits outweigh the high cost."
                  }
                ]
              },
              {
                "number": 30,
                "textHtml": "&nbsp;Sylvia and Greg agree that modern windmills",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "are the most efficient way of harnessing energy."
                  },
                  {
                    "letter": "B",
                    "textHtml": "should be put in carefully selected locations."
                  },
                  {
                    "letter": "C",
                    "textHtml": "make the landscape look unattractive."
                  }
                ]
              }
            ]
          }
