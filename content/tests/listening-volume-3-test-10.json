            "rubricHtml": "<p>Questions 11–15</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 11,
                "textHtml": "&nbsp;Stephen says the founders of extrahands.com originally needed help in",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "preparing their fields for planting."
                  },
                  {
                    "letter": "B",
                    "textHtml": "harvesting their organic crops."
                  },
                  {
                    "letter": "C",
                    "textHtml": "constructing their farm buildings."
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "&nbsp;To remain an active member of extrahands.com, you must",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "update your form on the website every year."
                  },
                  {
                    "letter": "B",
                    "textHtml": "pay a subscription of $25 every year."
                  },
                  {
                    "letter": "C",
                    "textHtml": "use the scheme as a host or volunteer every year."
                  }
                ]
              },
              {
                "number": 13,
                "textHtml": "&nbsp;Most extrahands.com volunteers search for jobs on the website according to",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the type of work available."
                  },
                  {
                    "letter": "B",
                    "textHtml": "the geographical location."
                  },
                  {
                    "letter": "C",
                    "textHtml": "the length of time required."
                  }
                ]
              },
              {
                "number": 14,
                "textHtml": "&nbsp;Stephen recommends that the host and volunteer should",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "confirm details of the arrangement in writing."
                  },
                  {
                    "letter": "B",
                    "textHtml": "draw up a formal written contract."
                  },
                  {
                    "letter": "C",
                    "textHtml": "meet each other before settling on terms."
                  }
                ]
              },
              {
                "number": 15,
                "textHtml": "&nbsp;To deal with members' problems, extrahands.com have a system",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "for checking each new member online."
                  },
                  {
                    "letter": "B",
                    "textHtml": "for allowing online feedback."
                  },
                  {
                    "letter": "C",
                    "textHtml": "for inspecting work and accommodation."
                  }
                ]
              }
            ]
