      {
        "number": 3,
        "title": "Part 3",
        "instructionsHtml": "<p>Listen and answer questions 21–30.</p>",
        "groups": [
          {
            "id": "part-3-group-1",
            "type": "completion",
            "rubricHtml": "<p>Questions 21–30</p>",
            "selectCount": 1,
            "bodyHtml": "<p>Complete the notes below. Write <strong>NO MORE THAN THREE WORDS AND/OR A NUMBER</strong> for each answer.</p><div><div class=\"notes-title\"><strong>Possible Course Change</strong></div><ul><li><strong>Name of student:</strong> Sally Layman</li><li><strong>Current course:</strong> {{21}}</li><li><strong>Date started:</strong> {{22}}</li></ul><p class=\"sub-head\"><strong>Courses interested in:</strong></p><ul><li>1st choice: {{23}}</li><li>2nd choice: {{24}}</li></ul><table class=\"q-table\"><tbody><tr><th>Problem</th><th>Strategies tried</th><th>Further strategies suggested</th></tr><tr><td>finds {{25}}</td><td>recording them</td><td>join other students in a {{26}}</td></tr><tr><td>{{27}}</td><td>talking to tutor</td><td>arrange meetings in advance</td></tr><tr><td>bad assignment</td><td>more background reading</td><td>{{28}}</td></tr></tbody></table><ul><li><strong>Date for next meeting:</strong> {{29}} at 3.30 p.m.</li><li><strong>With:</strong> {{30}}</li></ul></div>",
            "maxWords": 3
          }
        ]
      },
      {
        "number": 4,
        "title": "Part 4",
        "instructionsHtml": "<p>Listen and answer questions 31–40.</p>",
        "groups": [
          {
            "id": "part-4-group-1",
            "type": "mcq",
            "rubricHtml": "<p>Questions 31–40</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 31,
                "textHtml": "&nbsp;The museum started displaying perfume ornaments when",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "a collection was donated."
                  },
                  {
                    "letter": "B",
                    "textHtml": "the public showed an interest in them."
                  },
                  {
                    "letter": "C",
                    "textHtml": "an expert decided some of them were valuable."
                  }
                ]
              },
              {
                "number": 32,
                "textHtml": "&nbsp;People needed to wear perfume in the 11th century because",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "washing was considered dangerous."
                  },
                  {
                    "letter": "B",
                    "textHtml": "soap was not generally available."
                  },
                  {
                    "letter": "C",
                    "textHtml": "water shortages were common."
                  }
                ]
              },
              {
                "number": 33,
                "textHtml": "&nbsp;The perfume ornament known as a 'pomander' took its name from",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the substance it was made of."
                  },
                  {
                    "letter": "B",
                    "textHtml": "the liquid inside it."
                  },
                  {
                    "letter": "C",
                    "textHtml": "the person who invented it."
                  }
                ]
              },
              {
                "number": 34,
                "textHtml": "&nbsp;In medieval times, it was thought that wearing perfume made people",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "more wealthy."
                  },
                  {
                    "letter": "B",
                    "textHtml": "more attractive."
                  },
                  {
                    "letter": "C",
                    "textHtml": "more cheerful."
                  }
                ]
              },
              {
                "number": 35,
                "textHtml": "&nbsp;Craftsmen found ways of preventing liquid perfume from",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "being spilled."
                  },
                  {
                    "letter": "B",
                    "textHtml": "drying up."
                  },
                  {
                    "letter": "C",
                    "textHtml": "losing its scent."
                  }
                ]
              },
              {
                "number": 36,
                "textHtml": "&nbsp;The perfume in a vinaigrette was",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "preserved in solid form."
                  },
                  {
                    "letter": "B",
                    "textHtml": "absorbed by a sponge."
                  },
                  {
                    "letter": "C",
                    "textHtml": "heated over a flame."
                  }
                ]
              },
              {
                "number": 37,
                "textHtml": "&nbsp;Which part of the vinaigrette was made of gold?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the inside"
                  },
                  {
                    "letter": "B",
                    "textHtml": "the outside"
                  },
                  {
                    "letter": "C",
                    "textHtml": "the lid"
                  }
                ]
              },
              {
                "number": 38,
                "textHtml": "&nbsp;Perfume bottles used in the mid-19th century",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "were imports from outside Europe."
                  },
                  {
                    "letter": "B",
                    "textHtml": "could be bought by large numbers of people."
                  },
                  {
                    "letter": "C",
                    "textHtml": "were usually made of horn."
                  }
                ]
              },
              {
                "number": 39,
                "textHtml": "&nbsp;Tiffany bottles",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "were produced by a number of companies."
                  },
                  {
                    "letter": "B",
                    "textHtml": "could only be bought from catalogues."
                  },
                  {
                    "letter": "C",
                    "textHtml": "showed skilled use of crystal."
                  }
                ]
              },
              {
                "number": 40,
                "textHtml": "&nbsp;The 'Vanity' was",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "used for storing cosmetics."
                  },
                  {
                    "letter": "B",
                    "textHtml": "the smallest perfume ornament ever made."
                  },
                  {
                    "letter": "C",
                    "textHtml": "developed in the 1950s."
                  }
                ]
              }
            ]
          }
        ]
      }
