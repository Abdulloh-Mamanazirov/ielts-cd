                    "letter": "A",
                    "textHtml": "prepare some slides for it"
                  },
                  {
                    "letter": "B",
                    "textHtml": "find out how long they have for it"
                  },
                  {
                    "letter": "C",
                    "textHtml": "decide on its content and organisation"
                  }
                ]
              }
