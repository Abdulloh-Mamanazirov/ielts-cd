        "groups": [
          {
            "id": "part-3-group-1",
            "type": "mcq",
            "selectCount": 2,
            "rubricHtml": "<h3>Questions 21 and 22</h3><p>Choose <strong>TWO</strong> letters, <strong>A–E</strong>.</p><p>Which <strong>TWO</strong> points does Adam make about his experiment on artificial sweeteners?</p>",
            "questions": [
