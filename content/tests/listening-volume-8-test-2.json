      {
        "number": 3,
        "title": "Part 3",
        "instructionsHtml": "<p>Listen and answer questions 21–30.</p>",
        "groups": [
          {
            "id": "part-3-group-1",
            "type": "mcq",
            "rubricHtml": "<p>Questions 21–26</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 21,
                "textHtml": "&nbsp;Gina chose to study performance arts at this university because the course",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "has a very good reputation."
                  },
                  {
                    "letter": "B",
                    "textHtml": "has links with various theatres."
                  },
                  {
                    "letter": "C",
                    "textHtml": "has an international flavour."
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "&nbsp;Which of the options they chose have Gina and Charlie both found useful?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "Movement Analysis"
                  },
                  {
                    "letter": "B",
                    "textHtml": "Dance and Drama"
                  },
                  {
                    "letter": "C",
                    "textHtml": "The Body in Dance"
                  }
                ]
              },
              {
                "number": 23,
                "textHtml": "&nbsp;What did Charlie do during his work experience?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "He worked in a costume department."
                  },
                  {
                    "letter": "B",
                    "textHtml": "He performed with a ballet company."
                  },
                  {
                    "letter": "C",
                    "textHtml": "He helped out at a dance school for children."
                  }
                ]
              },
              {
                "number": 24,
                "textHtml": "&nbsp;What does Gina say she learnt from her work experience?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "how to organise her time better"
                  },
                  {
                    "letter": "B",
                    "textHtml": "how to work better in a team"
                  },
                  {
                    "letter": "C",
                    "textHtml": "how to cope when under pressure"
                  }
                ]
              },
              {
                "number": 25,
                "textHtml": "&nbsp;What does Charlie say about his dissertation topic?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "He wanted it to be different from those of other students."
                  },
                  {
                    "letter": "B",
                    "textHtml": "He had already done an assignment in this area."
                  },
                  {
                    "letter": "C",
                    "textHtml": "He was inspired to choose it by a performance he saw."
                  }
                ]
              },
              {
                "number": 26,
                "textHtml": "&nbsp;Which aspect of writing a dissertation is Gina worried about?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "finding enough to say"
                  },
                  {
                    "letter": "B",
                    "textHtml": "doing the background reading"
                  },
                  {
                    "letter": "C",
                    "textHtml": "presenting it in an appropriate way"
                  }
                ]
              }
            ]
          },
