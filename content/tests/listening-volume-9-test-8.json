            "questions": [
              {
                "number": 11,
                "textHtml": "&nbsp;A trip to the outdoor education centre will help the children",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "create good relationships"
                  },
                  {
                    "letter": "B",
                    "textHtml": "manage without adult supervision"
                  },
                  {
                    "letter": "C",
                    "textHtml": "react positively to new challenges"
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "&nbsp;To prepare their children for the trip, parents should",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "let them try sleeping in a tent at home"
                  },
                  {
                    "letter": "B",
                    "textHtml": "make sure they get enough sleep before they leave"
                  },
                  {
                    "letter": "C",
                    "textHtml": "tell them that they will be in a tent with their friends"
                  }
                ]
              },
              {
                "number": 13,
                "textHtml": "&nbsp;What do parents need to put in their children's backpack?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "plastic bags"
                  },
                  {
                    "letter": "B",
                    "textHtml": "snacks and biscuits"
                  },
                  {
                    "letter": "C",
                    "textHtml": "a small amount of money"
                  }
                ]
              },
              {
                "number": 14,
                "textHtml": "&nbsp;What are children allowed to bring on the trip?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "electronic games"
                  },
                  {
                    "letter": "B",
                    "textHtml": "cell phones"
                  },
                  {
                    "letter": "C",
                    "textHtml": "penknives"
                  }
                ]
              },
              {
                "number": 15,
                "textHtml": "&nbsp;How are parents selected to attend the trip?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "The first ten parents to sign up will be able to go"
                  },
                  {
                    "letter": "B",
                    "textHtml": "Parents' names will be chosen from a box"
                  },
                  {
                    "letter": "C",
                    "textHtml": "Preference will be given to parents with camping skills"
                  }
                ]
              },
              {
                "number": 16,
