                    "letter": "A",
                    "textHtml": "equipment for fishing"
                  },
                  {
                    "letter": "B",
                    "textHtml": "all food for both days"
                  },
                  {
                    "letter": "C",
                    "textHtml": "fuel for the fishing"
                  }
                ]
              },
              {
                "number": 13,
                "textHtml": "Participants without a fishing licence are recommended to apply for one",
