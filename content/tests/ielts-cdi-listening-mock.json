                    "letter": "B",
                    "textHtml": "a competitor number"
                  },
                  {
                    "letter": "C",
                    "textHtml": "cash for the entrance fee"
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "What does the entrance fee to the competition include?",
                "options": [
