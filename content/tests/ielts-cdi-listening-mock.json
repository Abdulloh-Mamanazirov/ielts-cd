        "groups": [
          {
            "id": "questions-21-26-choose-the-correct-answer",
            "type": "mcq",
            "rubricHtml": "<p><strong>Questions 21-26</strong></p><p>Choose the correct answer.</p><p>Preparing for the end-of-year art exhibition</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 21,
                "textHtml": "Max and Abby agree that in the art exhibition they are looking forward to",
                "options": [
