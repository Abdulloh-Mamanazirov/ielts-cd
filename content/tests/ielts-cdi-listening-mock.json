            "id": "questions-11-14-choose-the-correct-letter-a-b-or-c",
            "type": "mcq",
            "rubricHtml": "<p><strong>Questions 11-14</strong></p><p>Choose the correct letter A, B or C.</p><p>Information for participants in the Albany fishing competition</p>",
            "selectCount": 1,
            "questions": [
