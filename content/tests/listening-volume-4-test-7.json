            "questions": [
              {
                "number": 21,
                "textHtml": "&nbsp;What does Dr Owen advise Joel to include in the title of his project?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the location of the farms"
                  },
                  {
                    "letter": "B",
                    "textHtml": "the number of farmers"
                  },
                  {
                    "letter": "C",
                    "textHtml": "the types of farming"
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "&nbsp;Why has Joel decided to do face-to-face interviews?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "to see the farmers' workplaces"
                  },
                  {
                    "letter": "B",
                    "textHtml": "to limit the time he spends on the project"
                  },
                  {
                    "letter": "C",
                    "textHtml": "to get fuller answers"
                  }
                ]
              },
              {
                "number": 23,
                "textHtml": "&nbsp;Joel agrees to investigate how farmers get information on new developments",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "by showing them a series of pictures."
                  },
                  {
                    "letter": "B",
                    "textHtml": "by asking them open questions."
                  },
                  {
                    "letter": "C",
                    "textHtml": "by sending them a checklist in advance."
                  }
                ]
              },
              {
                "number": 24,
                "textHtml": "&nbsp;Concerning government communication with farmers, the speakers agree that",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "much of it is irrelevant."
                  },
                  {
                    "letter": "B",
                    "textHtml": "it is often insufficient for farmers' needs."
                  },
                  {
                    "letter": "C",
                    "textHtml": "the wording is sometimes unclear."
                  }
                ]
              },
              {
                "number": 25,
                "textHtml": "&nbsp;According to Joel's reading about the cost of making changes, many British farmers",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "leave investment decisions to their accountants."
                  },
                  {
                    "letter": "B",
                    "textHtml": "have too little time to calculate the costs of new methods."
                  },
                  {
                    "letter": "C",
                    "textHtml": "are reluctant to spend money on improvements."
                  }
                ]
              },
              {
                "number": 26,
                "textHtml": "&nbsp;A survey of Australian sheep farmers found that most of them",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "are usually reluctant to make changes."
                  },
                  {
                    "letter": "B",
                    "textHtml": "make changes based on limited research."
                  },
                  {
                    "letter": "C",
                    "textHtml": "want plenty of evidence before they make changes"
                  }
                ]
              }
            ]
