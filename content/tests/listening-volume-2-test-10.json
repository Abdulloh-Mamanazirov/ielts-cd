            "questions": [
              {
                "number": 16,
                "textHtml": "&nbsp;Elizabeth Arnold thinks people join a choir at work because it gives them a chance to",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "have a break from work."
                  },
                  {
                    "letter": "B",
                    "textHtml": "improve their singing."
                  },
                  {
                    "letter": "C",
                    "textHtml": "make business contacts."
                  }
                ]
              },
              {
                "number": 17,
                "textHtml": "&nbsp;How does a company benefit from setting up a choir?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "improved relationships between co-workers"
                  },
                  {
                    "letter": "B",
                    "textHtml": "less sick leave taken by employees"
                  },
                  {
                    "letter": "C",
                    "textHtml": "increased commitment to the company"
                  }
                ]
              },
              {
                "number": 18,
                "textHtml": "&nbsp;How many members does the John White choir have?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "5"
                  },
                  {
                    "letter": "B",
                    "textHtml": "12"
                  },
                  {
