                    "letter": "A",
                    "textHtml": "deal with them carefully"
                  },
                  {
                    "letter": "B",
                    "textHtml": "be financially advantageous"
                  },
                  {
                    "letter": "C",
                    "textHtml": "think in the long run"
                  }
                ]
              }
