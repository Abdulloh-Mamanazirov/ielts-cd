            "selectCount": 1,
            "questions": [
              {
                "number": 11,
                "textHtml": "&nbsp;What is the most important attitude towards making mistakes according to Arthur?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "Mistakes are inevitable."
                  },
                  {
                    "letter": "B",
                    "textHtml": "Mistakes can be a chance to learn."
                  },
                  {
                    "letter": "C",
                    "textHtml": "Mistakes can cause serious consequences."
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "&nbsp;What's true about self-confidence according to Arthur?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "self-confidence sometimes leads to failure"
                  },
                  {
                    "letter": "B",
                    "textHtml": "It means being ambitious with what you do"
                  },
                  {
                    "letter": "C",
                    "textHtml": "Self-confidence can be gained through reading"
                  }
                ]
              },
              {
                "number": 13,
                "textHtml": "&nbsp;What advice does Arthur give to new business leaders?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "Read business journals"
                  },
                  {
                    "letter": "B",
                    "textHtml": "try new things"
                  },
                  {
                    "letter": "C",
                    "textHtml": "Keep their aims"
                  }
                ]
              },
              {
                "number": 14,
                "textHtml": "&nbsp;How does Arthur deal with difficult problems?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "Ask for advice from friends"
                  },
                  {
                    "letter": "B",
                    "textHtml": "Seek help from experts"
                  },
                  {
                    "letter": "C",
                    "textHtml": "Try to get advice from books"
                  }
                ]
              },
              {
                "number": 15,
                "textHtml": "&nbsp;What's the common quality of leaders?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "Have good public speaking skills"
                  },
                  {
                    "letter": "B",
                    "textHtml": "Solve all problems skillfully"
                  },
                  {
                    "letter": "C",
                    "textHtml": "be respected by the workforce"
                  }
                ]
              },
              {
                "number": 16,
                "textHtml": "&nbsp;How should companies take risks?",
                "options": [
