      {
        "number": 1,
        "title": "Part 1",
        "instructionsHtml": "<p>Listen and answer questions 1–10.</p>",
        "groups": [
          {
            "id": "part-1-group-1",
            "type": "completion",
            "rubricHtml": "<p>Questions 1–10</p>",
            "selectCount": 1,
            "bodyHtml": "<p>Complete the table below. Write <strong>NO MORE THAN TWO WORDS AND/OR A NUMBER</strong> for each answer.</p><div><div><strong>Student Accommodation</strong></div><table class=\"q-table\"><tbody><tr><th>Type</th><th>Cost</th><th>Contract</th></tr><tr><td><em>Example:</em> College — single room</td><td>Standard £3276/yr; en-suite £{{1}}/yr (meals not included)</td><td>36 weeks (rooms not available during the {{2}})</td></tr><tr><td>{{3}} — room with a family</td><td>£150/week — all inclusive</td><td>Arrangements are {{4}}</td></tr><tr><td>Private renting: room in a share house or a {{5}}</td><td>£275–£490/month. Extra costs: gas &amp; electricity ≈ £{{6}}/month; {{7}}: £9; {{8}}</td><td>6 months. Need: {{9}}; two {{10}}</td></tr></tbody></table></div>",
            "maxWords": 2
          }
        ]
      },
      {
        "number": 2,
        "title": "Part 2",
        "instructionsHtml": "<p>Listen and answer questions 11–20.</p>",
        "groups": [
          {
            "id": "part-2-group-1",
            "type": "mcq",
            "rubricHtml": "<p>Questions 11–18 <span style=\"font-weight:400;\">(Global Museum audio guide)</span></p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 11,
                "textHtml": "&nbsp;The Heritage Clothes exhibition was put together by",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "museum staff."
                  },
                  {
                    "letter": "B",
                    "textHtml": "local residents."
                  },
                  {
                    "letter": "C",
                    "textHtml": "clothing manufacturers."
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "&nbsp;The photographs show the clothes worn by",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "their owners."
                  },
                  {
                    "letter": "B",
                    "textHtml": "professional models."
                  },
                  {
                    "letter": "C",
                    "textHtml": "design students."
                  }
                ]
              },
              {
                "number": 13,
                "textHtml": "&nbsp;The exhibition called Toys from the Past is",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "displayed in a new gallery."
                  },
                  {
                    "letter": "B",
                    "textHtml": "on show for a limited time."
                  },
                  {
                    "letter": "C",
                    "textHtml": "aimed specially at children."
                  }
                ]
              },
              {
                "number": 14,
                "textHtml": "&nbsp;Visitors to Toys from the Past are recommended to",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "play with the toy trains."
                  },
                  {
                    "letter": "B",
                    "textHtml": "look at all the dolls."
                  },
                  {
                    "letter": "C",
                    "textHtml": "see the board games."
                  }
                ]
              },
              {
                "number": 15,
                "textHtml": "&nbsp;The miniature toys have been",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "made by the museum."
                  },
                  {
                    "letter": "B",
                    "textHtml": "bought by the museum."
                  },
                  {
                    "letter": "C",
                    "textHtml": "borrowed by the museum."
                  }
                ]
              },
              {
                "number": 16,
                "textHtml": "&nbsp;The biscuit factory made tins",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "for people all over the world."
                  },
                  {
                    "letter": "B",
                    "textHtml": "of different shapes."
                  },
                  {
                    "letter": "C",
                    "textHtml": "for many famous people."
                  }
                ]
              },
              {
                "number": 17,
                "textHtml": "&nbsp;People's favourite biscuit used to be",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "an unsweetened one."
                  },
                  {
                    "letter": "B",
                    "textHtml": "one covered in chocolate."
                  },
                  {
                    "letter": "C",
                    "textHtml": "one filled with cream."
                  }
                ]
              },
              {
                "number": 18,
                "textHtml": "&nbsp;The hands-on activity allows people to",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "make some biscuits."
                  },
                  {
                    "letter": "B",
                    "textHtml": "taste some of the biscuits."
                  },
                  {
                    "letter": "C",
                    "textHtml": "pack a biscuit tin."
                  }
                ]
              }
            ]
          },
          {
            "id": "part-2-group-2",
            "type": "completion",
            "rubricHtml": "<p>Questions 19 and 20</p>",
            "selectCount": 1,
            "bodyHtml": "<p>Complete the sentences below. Write <strong>NO MORE THAN TWO WORDS</strong> for each answer.</p><div><ul><li><strong>19</strong> &nbsp;The gift shop is located beside the {{19}} on the ground floor.</li><li><strong>20</strong> &nbsp;Free {{20}} are available for visitors' belongings.</li></ul></div>",
            "maxWords": 2
          }
        ]
      },
      {
        "number": 3,
        "title": "Part 3",
        "instructionsHtml": "<p>Listen and answer questions 21–30.</p>",
        "groups": [
          {
            "id": "part-3-group-1",
            "type": "mcq",
            "rubricHtml": "<p>Questions 21–24 <span style=\"font-weight:400;\">(Pacific tapa cloth)</span></p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 21,
                "textHtml": "&nbsp;Pacific tapa cloth is different from other types of tapa cloth because it is",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the only tapa made today."
                  },
                  {
                    "letter": "B",
                    "textHtml": "better quality than others."
                  },
                  {
                    "letter": "C",
                    "textHtml": "put to a wider range of uses."
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "&nbsp;What does Helen say about the paper mulberry tree?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "It is also a source of food."
                  },
                  {
                    "letter": "B",
                    "textHtml": "It is not native to the Pacific."
                  },
                  {
                    "letter": "C",
                    "textHtml": "It can grow in any environment."
                  }
                ]
              },
              {
                "number": 23,
                "textHtml": "&nbsp;Why did the Maori people of New Zealand stop making tapa?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "They could not find the right trees in New Zealand."
                  },
                  {
                    "letter": "B",
                    "textHtml": "They were introduced to other fabrics by the Europeans."
                  },
                  {
                    "letter": "C",
                    "textHtml": "They found a better material for making fabric."
                  }
                ]
              },
              {
                "number": 24,
                "textHtml": "&nbsp;Large pieces of tapa are made from smaller pieces which are",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "stuck together."
                  },
                  {
                    "letter": "B",
                    "textHtml": "woven together."
                  },
                  {
                    "letter": "C",
                    "textHtml": "sewn together."
                  }
                ]
              }
            ]
          },
          {
