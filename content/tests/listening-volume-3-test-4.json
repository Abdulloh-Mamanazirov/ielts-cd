          {
            "id": "part-4-group-1",
            "type": "mcq",
            "rubricHtml": "<p>Questions 31 and 32 <span style=\"font-weight:400;\">(Learner Persistence study)</span></p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 31,
                "textHtml": "&nbsp;Participants in the learner Persistence study were all drawn from the same",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "age group."
                  },
                  {
                    "letter": "B",
                    "textHtml": "geographical area."
                  },
                  {
                    "letter": "C",
                    "textHtml": "socio-economic level."
                  }
                ]
              },
              {
                "number": 32,
                "textHtml": "&nbsp;The study showed that when starting their course, older students were most concerned about",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "effects on their home life."
                  },
                  {
                    "letter": "B",
                    "textHtml": "implications for their future career."
                  },
                  {
                    "letter": "C",
                    "textHtml": "financial constraints."
                  }
                ]
              }
            ]
