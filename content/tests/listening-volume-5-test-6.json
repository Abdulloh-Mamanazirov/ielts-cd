            "rubricHtml": "<p>Questions 11–14</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 11,
                "textHtml": "&nbsp;What should employees bring to work?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "gloves"
                  },
                  {
                    "letter": "B",
                    "textHtml": "lunch"
                  },
                  {
                    "letter": "C",
                    "textHtml": "water"
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "&nbsp;If employees can't come to work one day, they should",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "contact the duty manager."
                  },
                  {
                    "letter": "B",
                    "textHtml": "leave a phone message at the farm office."
                  },
                  {
                    "letter": "C",
                    "textHtml": "call their team leader."
                  }
                ]
              },
              {
                "number": 13,
                "textHtml": "&nbsp;One problem with customers that may occur now is that",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "they sometimes fail to return baskets."
                  },
                  {
                    "letter": "B",
                    "textHtml": "they eat the fruit before paying."
                  },
                  {
                    "letter": "C",
                    "textHtml": "they can be unsure about prices."
                  }
                ]
              },
              {
                "number": 14,
                "textHtml": "&nbsp;One of the benefits of working at the strawberry farm is that",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "employees' friends are entitled to a small discount."
                  },
                  {
                    "letter": "B",
                    "textHtml": "employees can have a quantity of fresh fruit for free."
                  },
                  {
                    "letter": "C",
                    "textHtml": "employees don't pay the full price for gift items in the shop."
                  }
                ]
              }
