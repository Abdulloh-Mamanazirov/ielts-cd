            "bodyHtml": "<div class=\"summary\">\n<div class=\"summary-title\">Job details from employment agency</div>\n<div class=\"form-row\"><span class=\"form-label\">Role</span><span class=\"form-value\">{{1}}</span></div>\n<div class=\"form-row\"><span class=\"form-label\">Location</span><span class=\"form-value\">Fordham {{2}} Centre<br>{{3}} Road, Fordham</span></div>\n<div class=\"notes-title\"><strong>Work involves</strong></div>\n<ul class=\"notes-list\">\n<li>dealing with enquiries</li>\n<li>making {{4}} and reorganising them</li>\n<li>maintaining the internal {{5}}</li>\n<li>general administration</li>\n</ul>\n<div><strong>Requirements</strong></div>\n<ul class=\"notes-list\">\n<li>{{6}} (essential)</li>\n<li>a calm and {{7}} manner</li>\n<li>good IT skills</li>\n</ul>\n<div><strong>Other information</strong></div>\n<ul class=\"notes-list\">\n<li>a {{8}} job – further opportunities may be available</li>\n<li>hours: 7.45 a.m. to {{9}} p.m. Monday to Friday</li>\n<li>{{10}} is available onsite</li>\n</ul>\n</div>"
          }
