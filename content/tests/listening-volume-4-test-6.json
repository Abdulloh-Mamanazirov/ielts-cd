            "questions": [
              {
                "number": 21,
                "textHtml": "&nbsp;Edward heard about a type of mosquito net from",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "an administrator."
                  },
                  {
                    "letter": "B",
                    "textHtml": "a doctor."
                  },
                  {
                    "letter": "C",
                    "textHtml": "a friend."
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "&nbsp;Edward believes that mosquito nets were first used in",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "China."
                  },
                  {
                    "letter": "B",
                    "textHtml": "Japan."
                  },
                  {
                    "letter": "C",
                    "textHtml": "Egypt."
                  }
                ]
              },
              {
                "number": 23,
                "textHtml": "&nbsp;Chemical treatment of mosquito nets in the mid-twentieth century",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "was first developed by a soldier."
                  },
                  {
                    "letter": "B",
                    "textHtml": "made them potentially dangerous to users."
                  },
                  {
                    "letter": "C",
                    "textHtml": "was made possible by modern textiles."
                  }
                ]
              },
              {
                "number": 24,
                "textHtml": "&nbsp;The owners of present-day nets",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "are likely to find they have an unpleasant smell."
                  },
                  {
                    "letter": "B",
                    "textHtml": "should avoid using them every night."
                  },
                  {
                    "letter": "C",
                    "textHtml": "may have difficulty obtaining the necessary chemical."
                  }
                ]
              },
              {
                "number": 25,
                "textHtml": "&nbsp;According to Edward, Olyset nets are better than other nets because they",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "remain effective for longer."
                  },
                  {
                    "letter": "B",
                    "textHtml": "use a greater number of chemicals"
                  },
                  {
                    "letter": "C",
                    "textHtml": "give protection against more types of insects."
                  }
                ]
              }
            ]
