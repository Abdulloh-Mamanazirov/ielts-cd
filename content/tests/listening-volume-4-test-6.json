              {
                "number": 17,
                "textHtml": "&nbsp;If you want to do the theory course, you",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "have to reserve a place."
                  },
                  {
                    "letter": "B",
                    "textHtml": "can get details on the internet."
                  },
                  {
                    "letter": "C",
                    "textHtml": "must pay the whole cost in advance."
                  }
                ]
              },
              {
                "number": 18,
                "textHtml": "&nbsp;What does the woman say about the theory classes?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "They are available in more than one language"
                  },
                  {
                    "letter": "B",
                    "textHtml": "All the necessary materials are provided."
                  },
                  {
                    "letter": "C",
                    "textHtml": "Trainees stay together for the whole course."
                  }
                ]
              },
              {
                "number": 19,
                "textHtml": "&nbsp;What does the woman say about the practical course?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "You must attend a session every day."
                  },
                  {
                    "letter": "B",
                    "textHtml": "You are allowed to drive your own car"
                  },
                  {
                    "letter": "C",
                    "textHtml": "You can book at certain shops."
                  }
                ]
              },
              {
                "number": 20,
                "textHtml": "&nbsp;There is no charge for a cancelled practical session if",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "the instructor agrees to reschedule it."
                  },
                  {
                    "letter": "B",
                    "textHtml": "the required amount of notice is given."
                  },
                  {
                    "letter": "C",
                    "textHtml": "a medical certificate is produced"
                  }
                ]
              }
            ]
