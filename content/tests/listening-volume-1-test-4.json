      {
        "number": 3,
        "title": "Part 3",
        "instructionsHtml": "<p>Listen and answer questions 21–30.</p>",
        "groups": [
          {
            "id": "part-3-group-1",
            "type": "mcq",
            "rubricHtml": "<p>Questions 21–26: Choose the correct letter, A, B or C.</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 21,
                "textHtml": "&nbsp;Max and Abby agree that in the art exhibition they are looking forward to",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "&nbsp; showing people their work."
                  },
                  {
                    "letter": "B",
                    "textHtml": "&nbsp; getting feedback from their tutor."
                  },
                  {
                    "letter": "C",
                    "textHtml": "&nbsp; talking to other students about their displays."
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "&nbsp;In last year's exhibition, both students were impressed by",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "&nbsp; a set of metal sculptures."
                  },
                  {
                    "letter": "B",
                    "textHtml": "&nbsp; a series of wooden models."
                  },
                  {
                    "letter": "C",
                    "textHtml": "&nbsp; a collection of textile designs."
                  }
                ]
              },
              {
                "number": 23,
                "textHtml": "&nbsp;What has Max decided to call his display?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "&nbsp; Mother Nature"
                  },
                  {
                    "letter": "B",
                    "textHtml": "&nbsp; Views of Farmland"
                  },
                  {
                    "letter": "C",
                    "textHtml": "&nbsp; Seasons"
                  }
                ]
              },
              {
                "number": 24,
                "textHtml": "&nbsp;What does Abby think will be difficult about preparing for their displays?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "&nbsp; having enough time to set it up"
                  },
                  {
                    "letter": "B",
                    "textHtml": "&nbsp; choosing which pieces to show"
                  },
                  {
                    "letter": "C",
                    "textHtml": "&nbsp; filling up all the available space"
                  }
                ]
              },
              {
                "number": 25,
                "textHtml": "&nbsp;What does Abby say about the summary they have to write?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "&nbsp; She isn't sure whether people will read it."
                  },
                  {
                    "letter": "B",
                    "textHtml": "&nbsp; It will be difficult to keep it short enough."
                  },
                  {
                    "letter": "C",
                    "textHtml": "&nbsp; It will be hard to clarify the reasons for her work."
                  }
                ]
              },
              {
                "number": 26,
                "textHtml": "&nbsp;What aspect of the display will the students organise themselves?",
