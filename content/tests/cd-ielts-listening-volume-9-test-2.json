            "rubricHtml": "<h3>Questions 11–15</h3><p>Choose the correct letter, A, B or C.</p><p><strong>Re-creating life in an Iron Age village</strong></p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 11,
                "textHtml": "Jim says that in the Iron Age village",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "he is sometimes cold at night."
                  },
                  {
                    "letter": "B",
                    "textHtml": "he always gets up early."
                  },
                  {
                    "letter": "C",
                    "textHtml": "he has time to himself."
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "What does Jim say about the food they eat in the village?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "It takes time to prepare."
                  },
                  {
                    "letter": "B",
                    "textHtml": "It is difficult to get used to."
                  },
                  {
                    "letter": "C",
                    "textHtml": "It has to be eaten quickly."
                  }
