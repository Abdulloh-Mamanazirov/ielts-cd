        "title": "Organising a Debate",
        "instructionsHtml": "<h3>Part 3</h3><p>Listen and answer questions 21–30.</p><p><strong>Organising a Debate</strong></p>",
        "groups": [
          {
            "id": "questions-21-26",
            "type": "mcq",
            "rubricHtml": "<h3>Questions 21–26</h3><p>Choose the correct letter, A, B or C.</p><p><strong>Organising a debate</strong></p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 21,
                "textHtml": "Why is Fiona keen to organise a debate?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "She has attended debates in other departments."
                  },
                  {
                    "letter": "B",
                    "textHtml": "She organised debates while at secondary school."
                  },
                  {
                    "letter": "C",
                    "textHtml": "She has talked about debating with a friend."
                  }
                ]
              },
              {
                "number": 22,
                "textHtml": "Fiona says that an advantage of debating is that it can",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "help students to form opinions."
                  },
                  {
                    "letter": "B",
                    "textHtml": "improve students' listening skills."
                  },
                  {
                    "letter": "C",
                    "textHtml": "develop students' self-confidence."
                  }
