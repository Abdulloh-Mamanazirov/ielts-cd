            "rubricHtml": "<p>Questions 11–16</p>",
            "selectCount": 1,
            "questions": [
              {
                "number": 11,
                "textHtml": "&nbsp;Who founded the Middletown Urban Farming Scheme?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "university specialists"
                  },
                  {
                    "letter": "B",
                    "textHtml": "business people"
                  },
                  {
                    "letter": "C",
                    "textHtml": "town planners"
                  }
                ]
              },
              {
                "number": 12,
                "textHtml": "&nbsp;What was the original reason for starting the MUFS?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "to encourage more efficient land use"
                  },
                  {
                    "letter": "B",
                    "textHtml": "to help lessen CO2 emissions"
                  },
                  {
                    "letter": "C",
                    "textHtml": "to improve people's eating habits"
                  }
                ]
              },
              {
                "number": 13,
                "textHtml": "&nbsp;For the coming year, the MUFS will focus on recruiting members from",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "schools."
                  },
                  {
                    "letter": "B",
                    "textHtml": "companies."
                  },
                  {
                    "letter": "C",
                    "textHtml": "community centres"
                  }
                ]
              },
              {
                "number": 14,
                "textHtml": "&nbsp;What kind of information is available from members of the MUFS committee?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "practical gardening tips"
                  },
                  {
                    "letter": "B",
                    "textHtml": "plant science"
                  },
                  {
                    "letter": "C",
                    "textHtml": "location of local garden sites"
                  }
                ]
              },
              {
                "number": 15,
                "textHtml": "&nbsp;What are provided by the MUFS for the physically disabled?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "soil and compost"
                  },
                  {
                    "letter": "B",
                    "textHtml": "containers for plants"
                  },
                  {
                    "letter": "C",
                    "textHtml": "gardening tools"
                  }
                ]
              },
              {
                "number": 16,
                "textHtml": "&nbsp;According to school teachers, what has been an unexpected advantage of the MUFS?",
                "options": [
                  {
                    "letter": "A",
                    "textHtml": "its usefulness as an aid for teaching science"
                  },
                  {
                    "letter": "B",
                    "textHtml": "its contribution to reducing costs of school meals"
                  },
                  {
                    "letter": "C",
                    "textHtml": "its help in encouraging community pride among students"
                  }
                ]
              }
