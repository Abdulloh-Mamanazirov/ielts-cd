# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# uploaded listening audio and speaking recordings
/.media/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Source test media. The reading HTML originals are versioned because they are
# small and are what the converters parse; the audio — and the listening HTML
# exports, which embed ~190 MB of it as base64 data URLs — is kept on disk and
# re-hosted to the media directory rather than living in git history forever.
# `npm run convert` extracts the audio to _source-tests/*.mp3; the listening
# JSON it writes is versioned, so the server needs only the audio (by scp), not
# these sources. See docs/DEPLOY.md.
/_source-tests/*.mp3
/_source-tests/*.m4a
/_source-tests/*.wav
# Any listening source, however it is named ("Listening Test 1", "IELTS_Listening_…",
# "Real Exam Listening …") — some embed 15-40 MB of base64 audio, and the JSON the
# converter writes (plus audioSourceUrl for the external ones) is the versioned truth.
/_source-tests/*[Ll]istening*.html

# Windows crash dumps
*.stackdump
