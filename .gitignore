# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# uploaded listening audio and speaking recordings
/.media/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Source test material is not versioned. The converted JSON in content/tests/ is
# the source of truth; the HTML/PDF/audio sources are re-uploaded locally as
# needed (they arrive in ad-hoc folders under ever-changing names, and some
# listening exports embed 40 MB of base64 audio). `npm run convert` reads
# whatever is here and writes the JSON, which is what the server and seed use.
# Only the note explaining the folder is tracked. See docs/DEPLOY.md.
/_source-tests/*
!/_source-tests/README.md

# Windows crash dumps
*.stackdump
