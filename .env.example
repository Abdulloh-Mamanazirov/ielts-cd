# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
# Local dev: your Postgres 15 instance. Create the database first:
#   createdb -U postgres ielts_dev
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ielts_dev?schema=public"

# --- Sessions ---
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# --- File storage (listening audio, speaking recordings) ---
# Absolute path OUTSIDE the web root. Files are streamed through an authenticated
# route, never served directly, so this must not live under public/.
MEDIA_STORAGE_DIR="D:/Projects/davronbek/.media"

# In production, nginx serves media via X-Accel-Redirect. This is the internal
# location prefix configured in nginx that maps to MEDIA_STORAGE_DIR.
# Leave empty in development to stream through Node instead.
MEDIA_INTERNAL_PREFIX=""

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed script only: creates the first admin account.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Davronbek Nabiev"
